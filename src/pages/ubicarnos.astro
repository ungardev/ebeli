---
import MainLayout from '@/layouts/MainLayout.astro';
import UbicarnosMap from '@/components/sections/landing/UbicarnosMap.astro';
import '@styles/reveal.css';

const pageTitle = 'Ubícanos | Ébeli';
const metaDescription = 'Encuentra representantes y clientes Ébeli en todo Venezuela. Mapa interactivo y directorio de distribuidores y clientes.';
---

<MainLayout title={pageTitle} customDescription={metaDescription}>
  <section class="relative bg-black pt-[88px] pb-20 md:pt-20 md:pb-24 lg:pb-28">
    <div class="mx-auto max-w-[1078px] px-4 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-[300] text-white uppercase tracking-[0.15em] mb-4 reveal" style="font-family: var(--font-manrope);">
        Ubícanos
      </h1>
      <p class="text-2xl md:text-4xl text-neutral-400 uppercase tracking-[0.05em] reveal reveal-delay-1" style="font-family: var(--font-manrope);">
        Nuestra presencia en toda Venezuela
      </p>
    </div>
  </section>

  <UbicarnosMap />
</MainLayout>