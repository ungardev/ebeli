---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import ProductsPreview from '@components/sections/landing/ProductsPreview.astro';
import '@styles/reveal.css';
---

<MainLayout>
  <HeroSection
    subTitle="TRANSFORMAMOS ESPACIOS CON LUZ"
    primaryBtn="Ver Productos"
    primaryBtnURL="/products"
    secondaryBtn="Únete"
    secondaryBtnURL="/distribuidor"
  />

  <ProductsPreview />

<!-- Nosotros Section - WARM BEIGE -->
  <section id="nosotros" class="relative py-24 md:py-28 lg:py-36 bg-[#F8F6F1]">
    
    <div class="relative mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-5xl md:text-6xl lg:text-7xl font-[300] text-black mb-8 tracking-[0.02em] reveal" style="font-family: var(--font-roobert);">Transformamos tus espacios</h2>
      <p class="text-xl md:text-2xl text-neutral-600 max-w-2xl mx-auto mb-16 reveal reveal-delay-1">
        En Ébeli diseñamos soluciones de iluminación LED que combinan eficiencia energética, diseño elegante y tecnología de vanguardia para hogares y negocios.
      </p>
      
      <!-- Stats Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16 max-w-4xl mx-auto stagger-children">
        <div class="stat-item group">
          <div 
            class="text-6xl md:text-7xl lg:text-8xl font-[300] text-black mb-6 transition-all duration-300 group-hover:drop-shadow-[0_0_50px_rgba(0,0,0,0.2)]" 
            style="font-family: var(--font-roobert);" 
            data-counter="500"
          >
            0
          </div>
          <p class="text-base md:text-lg text-neutral-600">Clientes satisfechos</p>
        </div>
        <div class="stat-item group">
          <div 
            class="text-6xl md:text-7xl lg:text-8xl font-[300] text-black mb-6 transition-all duration-300 group-hover:drop-shadow-[0_0_50px_rgba(0,0,0,0.2)]" 
            style="font-family: var(--font-roobert);" 
            data-counter="10"
          >
            0
          </div>
          <p class="text-base md:text-lg text-neutral-600">Años de experiencia</p>
        </div>
        <div class="stat-item group">
          <div 
            class="text-6xl md:text-7xl lg:text-8xl font-[300] text-black mb-6 transition-all duration-300 group-hover:drop-shadow-[0_0_50px_rgba(0,0,0,0.2)]" 
            style="font-family: var(--font-roobert);" 
            data-counter="50"
          >
            0
          </div>
          <p class="text-base md:text-lg text-neutral-600">Productos disponibles</p>
        </div>
      </div>
    </div>
  </section>

<!-- CTA Section - BLACK -->
  <section class="relative py-24 md:py-28 lg:py-32 bg-black">
    
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8 text-center">
      
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-[300] text-white mb-6 tracking-[0.02em] reveal" style="font-family: var(--font-roobert);">¿Listo para <span class="text-shadow-glow">iluminar</span>?</h2>
      <p class="text-lg md:text-xl text-neutral-400 mb-12 max-w-xl mx-auto reveal reveal-delay-1">
        Contáctanos por WhatsApp y te ayudamos a encontrar la solución perfecta para tu proyecto.
      </p>
      
      <a
        href="https://wa.me/"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 border border-white/30 bg-transparent hover:bg-white/5 text-white font-[600] px-14 py-6 transition-all duration-300 hover:scale-105 hover:border-white/50 scale-in reveal reveal-delay-2"
        style="font-family: var(--font-roobert); border-radius: 75.024px;"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="text-lg">Hablar por WhatsApp</span>
      </a>
    </div>
  </section>

  <!-- Counter Animation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const counters = document.querySelectorAll('[data-counter]');
      
      const observerOptions = {
        threshold: 0.5,
        rootMargin: '0px'
      };
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            const endValue = parseInt(target.dataset.counter || '0');
            let current = 0;
            const duration = 1000;
            const increment = endValue / (duration / 16);
            
            const updateCounter = () => {
              current += increment;
              if (current < endValue) {
                target.textContent = Math.floor(current) + '+';
                requestAnimationFrame(updateCounter);
              } else {
                target.textContent = endValue + '+';
              }
            };
            
            updateCounter();
            observer.unobserve(target);
          }
        });
      }, observerOptions);
      
      counters.forEach(counter => observer.observe(counter));
    });
  </script>
</MainLayout>

<style>
  .product-card {
    cursor: pointer;
  }
  
  .product-card:hover h3 {
    color: #1a1a1a;
  }
  
  img {
    opacity: 1;
    transition: opacity 0.3s ease;
  }
  
  img[loading="lazy"] {
    opacity: 0;
  }
  
  img[loading="lazy"].loaded,
  img:not([loading="lazy"]) {
    opacity: 1;
  }

  /* Stat item counter pulse effect */
  .stat-item:hover div {
    filter: drop-shadow(0 0 30px rgba(0, 0, 0, 0.15));
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lazyImages = document.querySelectorAll('img[loading="lazy"]');
    lazyImages.forEach(img => {
      if ((img as HTMLImageElement).complete) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => img.classList.add('loaded'));
      }
    });
  });
</script>