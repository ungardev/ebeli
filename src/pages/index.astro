---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
---

<MainLayout>
  <HeroSection
    title="ÉBELI"
    subTitle="Iluminación LED Premium"
    primaryBtn="Ver Productos"
    primaryBtnURL="/products"
    secondaryBtn="Hablar por WhatsApp"
    secondaryBtnURL="https://wa.me/"
  />

  <section class="relative py-12 md:py-14">
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-[400] text-white mb-4" style="font-family: var(--font-roobert);">Productos Destacados</h2>
        <p class="text-[#6d6d6d] text-lg">Soluciones de iluminación para cada espacio</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[14px]">
        <a href="/products/item-a765" class="group relative overflow-hidden rounded-xl bg-[#181818] border border-white/10 p-5 transition-all duration-500 hover:scale-[1.02] hover:border-white/20">
          <div class="aspect-square bg-neutral-800 rounded-lg mb-5 overflow-hidden">
            <img src="/_astro/product-image-main-1.DocbQbk7_Zg1lkn.avif" alt="LED Product 1" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
          </div>
          <h3 class="text-white font-[400] text-lg">Línea A</h3>
          <p class="text-[#6d6d6d] text-sm mt-1">Iluminación Interior</p>
        </a>
        
        <a href="/products/item-b203" class="group relative overflow-hidden rounded-xl bg-[#181818] border border-white/10 p-5 transition-all duration-500 hover:scale-[1.02] hover:border-white/20">
          <div class="aspect-square bg-neutral-800 rounded-lg mb-5 overflow-hidden">
            <img src="/_astro/product-image-main-2.CcfjfBQ9_ZCouPA.avif" alt="LED Product 2" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
          </div>
          <h3 class="text-white font-[400] text-lg">Línea B</h3>
          <p class="text-[#6d6d6d] text-sm mt-1">Iluminación Exterior</p>
        </a>
        
        <a href="/products/item-f303" class="group relative overflow-hidden rounded-xl bg-[#181818] border border-white/10 p-5 transition-all duration-500 hover:scale-[1.02] hover:border-white/20">
          <div class="aspect-square bg-neutral-800 rounded-lg mb-5 overflow-hidden">
            <img src="/_astro/product-image-main-3.CZjWzLDc_1vPkhV.avif" alt="LED Product 3" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
          </div>
          <h3 class="text-white font-[400] text-lg">Línea F</h3>
          <p class="text-[#6d6d6d] text-sm mt-1">Paneles LED</p>
        </a>
        
        <a href="/products/item-t845" class="group relative overflow-hidden rounded-xl bg-[#181818] border border-white/10 p-5 transition-all duration-500 hover:scale-[1.02] hover:border-white/20">
          <div class="aspect-square bg-neutral-800 rounded-lg mb-5 overflow-hidden">
            <img src="/_astro/product-image-main-4.Bkgr1GB5_JJQIe.avif" alt="LED Product 4" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
          </div>
          <h3 class="text-white font-[400] text-lg">Línea T</h3>
          <p class="text-[#6d6d6d] text-sm mt-1">Tiras LED</p>
        </a>
      </div>
      
      <div class="text-center mt-12">
        <a href="/products" class="group inline-flex items-center gap-3 text-white font-[400] transition-colors hover:text-[#6d6d6d]" style="font-family: var(--font-roobert);">
          <span>Ver Todos los Productos</span>
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section id="nosotros" class="relative py-12 md:py-14">
    <!-- Brand: subtle gradient depth -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#181818]/30 to-transparent"></div>
    
    <div class="relative mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-[400] text-white mb-6" style="font-family: var(--font-roobert);">Transformamos tus espacios</h2>
      <p class="text-[#6d6d6d] text-lg max-w-2xl mx-auto mb-12">
        En Ébeli diseñamos soluciones de iluminación LED que combinan eficiencia energética, diseño elegante y tecnología de vanguardia para hogares y negocios.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 max-w-4xl mx-auto">
        <div class="group">
          <div class="text-5xl md:text-6xl font-[300] text-white mb-3 transition-all duration-300 group-hover:drop-shadow-[0_0_30px_rgba(255,255,255,0.3)]" style="font-family: var(--font-roobert);" data-counter="500">0</div>
          <p class="text-[#6d6d6d]">Clientes satisfechos</p>
        </div>
        <div class="group">
          <div class="text-5xl md:text-6xl font-[300] text-white mb-3 transition-all duration-300 group-hover:drop-shadow-[0_0_30px_rgba(255,255,255,0.3)]" style="font-family: var(--font-roobert);" data-counter="10">0</div>
          <p class="text-[#6d6d6d]">Años de experiencia</p>
        </div>
        <div class="group">
          <div class="text-5xl md:text-6xl font-[300] text-white mb-3 transition-all duration-300 group-hover:drop-shadow-[0_0_30px_rgba(255,255,255,0.3)]" style="font-family: var(--font-roobert);" data-counter="50">0</div>
          <p class="text-[#6d6d6d]">Productos disponibles</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-12 md:py-14">
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8 text-center">
      
      <h2 class="text-3xl md:text-4xl font-[400] text-white mb-6" style="font-family: var(--font-roobert);">¿Listo para iluminar?</h2>
      <p class="text-[#6d6d6d] mb-10 max-w-xl mx-auto">
        Contáctanos por WhatsApp y te ayudamos a encontrar la solución perfecta para tu proyecto.
      </p>
      <a
        href="https://wa.me/"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 bg-green-600 hover:bg-green-500 text-white font-[600] px-10 py-5 rounded-full transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-green-500/30"
        style="font-family: var(--font-roobert); border-radius: 75.024px;"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Hablar por WhatsApp</span>
      </a>
    </div>
  </section>

  <script>
    const counters = document.querySelectorAll('[data-counter]');
    
    const observerOptions = {
      threshold: 0.5
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const endValue = parseInt(target.dataset.counter || '0');
          let current = 0;
          const duration = 2000;
          const increment = endValue / (duration / 16);
          
          const updateCounter = () => {
            current += increment;
            if (current < endValue) {
              target.textContent = Math.floor(current) + '+';
              requestAnimationFrame(updateCounter);
            } else {
              target.textContent = endValue + '+';
            }
          };
          
          updateCounter();
          observer.unobserve(target);
        }
      });
    }, observerOptions);
    
    counters.forEach(counter => observer.observe(counter));
  </script>
</MainLayout>