---
import MainLayout from '@/layouts/MainLayout.astro';
import InstagramFeed from '@components/sections/landing/InstagramFeed.astro';
import '@styles/reveal.css';

const pageTitle = 'CONTACTO | Ébeli';
const metaDescription = 'Contáctanos para encontrar la solución de iluminación LED perfecta para tu proyecto.';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
>
  <!-- Hero Section - BLACK -->
  <section class="relative bg-black pt-[88px] pb-20 md:pt-20 md:pb-24 lg:pb-28">
    <div class="mx-auto max-w-[1078px] px-4 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-[300] text-white uppercase tracking-[0.15em] mb-4 reveal" style="font-family: var(--font-roobert);">
        CONTACTO
      </h1>
      <p class="text-xl md:text-2xl text-neutral-400 uppercase tracking-[0.1em] reveal reveal-delay-1" style="font-family: var(--font-roobert);">
        ¿Tienes un proyecto en mente? Hablemos y encontremos la mejor solución de iluminación para ti.
      </p>
    </div>
  </section>

  <!-- Contact Cards Section - WHITE -->
  <section class="relative py-16 md:py-20 lg:py-24 bg-white">
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 stagger-children">

        <!-- WhatsApp Card -->
        <a 
          href="https://wa.me/584242280730?text=%C2%A1Hola!%20Quiero%20conocer%20los%20productos%20de%20iluminaci%C3%B3n%20LED%20de%20%C3%89beli"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative overflow-hidden rounded-2xl bg-neutral-100 border border-neutral-200 p-8 lg:p-10 transition-all duration-300 hover:scale-[1.02] hover:border-neutral-300 hover:shadow-[0_0_40px_rgba(0,0,0,0.15)]"
        >
          <div class="flex flex-col items-center text-center">
            <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-neutral-200">
              <svg class="h-10 w-10 text-[#059669]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <h2 class="text-2xl font-[400] text-black mb-3" style="font-family: var(--font-roobert);">
              WhatsApp
            </h2>
            <p class="text-neutral-500 mb-6" style="font-family: var(--font-roobert);">
              La forma más rápida de contactarnos
            </p>
            <span class="inline-flex items-center gap-2 text-[#059669] font-[400] text-lg transition-all duration-200 group-hover:gap-3" style="font-family: var(--font-roobert);">
              Abrir WhatsApp
              <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </a>

        <!-- Email Card -->
        <a 
          href="mailto:info@ebelive.com"
          class="group relative overflow-hidden rounded-2xl bg-neutral-100 border border-neutral-200 p-8 lg:p-10 transition-all duration-300 hover:scale-[1.02] hover:border-neutral-300 hover:shadow-[0_0_40px_rgba(0,0,0,0.15)]"
        >
          <div class="flex flex-col items-center text-center">
            <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-neutral-200">
              <svg class="h-10 w-10 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="text-2xl font-[400] text-black mb-3" style="font-family: var(--font-roobert);">
              Correo Electrónico
            </h2>
            <p class="text-neutral-500 mb-6" style="font-family: var(--font-roobert);">
              Para consultas detalladas y profesional
            </p>
            <span class="inline-flex items-center gap-2 text-black font-[400] text-lg transition-all duration-200 group-hover:gap-3 group-hover:text-neutral-600" style="font-family: var(--font-roobert);">
              info@ebelive.com
              <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- FAQ Section - WHITE -->
  <section class="relative py-16 md:py-20 lg:py-24 bg-white">
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-[300] text-black text-center mb-12 reveal" style="font-family: var(--font-roobert);">
        Preguntas Frecuentes
      </h2>

      <div class="max-w-3xl mx-auto space-y-4" id="faq-accordion">
        <!-- FAQ 1 -->
        <div class="faq-item border border-neutral-200 rounded-xl overflow-hidden reveal">
          <button
            class="faq-trigger w-full flex items-center justify-between p-6 md:p-8 text-left bg-neutral-50 hover:bg-neutral-100 transition-colors duration-300"
            aria-expanded="false"
          >
            <span class="text-lg md:text-xl font-[500] text-black pr-4" style="font-family: var(--font-roobert);">
              ¿Cuáles son los montos mínimos de compra?
            </span>
            <svg class="faq-chevron w-6 h-6 text-black flex-shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content hidden bg-white">
            <div class="p-6 md:p-8 text-neutral-600 leading-relaxed" style="font-family: var(--font-roobert);">
              Trabajamos con pedidos desde <strong class="text-black">$100 USD</strong> para clientes distribuidores. Para compras menores, puedes visitar nuestros puntos de venta autorizados o contactarnos directamente para evaluar opciones.
            </div>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="faq-item border border-neutral-200 rounded-xl overflow-hidden reveal reveal-delay-1">
          <button
            class="faq-trigger w-full flex items-center justify-between p-6 md:p-8 text-left bg-neutral-50 hover:bg-neutral-100 transition-colors duration-300"
            aria-expanded="false"
          >
            <span class="text-lg md:text-xl font-[500] text-black pr-4" style="font-family: var(--font-roobert);">
              ¿Cuáles son los tiempos de entrega?
            </span>
            <svg class="faq-chevron w-6 h-6 text-black flex-shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content hidden bg-white">
            <div class="p-6 md:p-8 text-neutral-600 leading-relaxed" style="font-family: var(--font-roobert);">
              Los tiempos de entrega varían según la ubicación y disponibilidad del producto. Generalmente, para productos en stock, la entrega se realiza entre <strong class="text-black">3 a 7 días hábiles</strong>. Para pedidos especiales o grandes volúmenes, el tiempo puede extenderse a 10-15 días.
            </div>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="faq-item border border-neutral-200 rounded-xl overflow-hidden reveal reveal-delay-2">
          <button
            class="faq-trigger w-full flex items-center justify-between p-6 md:p-8 text-left bg-neutral-50 hover:bg-neutral-100 transition-colors duration-300"
            aria-expanded="false"
          >
            <span class="text-lg md:text-xl font-[500] text-black pr-4" style="font-family: var(--font-roobert);">
              ¿Ofrecen crédito comercial?
            </span>
            <svg class="faq-chevron w-6 h-6 text-black flex-shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content hidden bg-white">
            <div class="p-6 md:p-8 text-neutral-600 leading-relaxed" style="font-family: var(--font-roobert);">
              Sí, ofrecemos condiciones de pago flexibles para distribuidores autorizados. После evaluación crediticia, puedes acceder a <strong class="text-black">cuotas de 30, 60 o 90 días</strong>. Contáctanos para más información sobre nuestros términos de crédito comercial.
            </div>
          </div>
        </div>

        <!-- FAQ 4 -->
        <div class="faq-item border border-neutral-200 rounded-xl overflow-hidden reveal reveal-delay-3">
          <button
            class="faq-trigger w-full flex items-center justify-between p-6 md:p-8 text-left bg-neutral-50 hover:bg-neutral-100 transition-colors duration-300"
            aria-expanded="false"
          >
            <span class="text-lg md:text-xl font-[500] text-black pr-4" style="font-family: var(--font-roobert);">
              ¿Tienen garantía en productos comercializados?
            </span>
            <svg class="faq-chevron w-6 h-6 text-black flex-shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content hidden bg-white">
            <div class="p-6 md:p-8 text-neutral-600 leading-relaxed" style="font-family: var(--font-roobert);">
              Todos nuestros productos cuentan con <strong class="text-black">2 años de garantía</strong> por defectos de fabricación. La garantía no cubre daños por mala instalación, manejo inadecuado o variaciones de voltaje. Para hacer válida la garantía, necesitas tu factura de compra.
            </div>
          </div>
        </div>

        <!-- FAQ 5 -->
        <div class="faq-item border border-neutral-200 rounded-xl overflow-hidden reveal reveal-delay-4">
          <button
            class="faq-trigger w-full flex items-center justify-between p-6 md:p-8 text-left bg-neutral-50 hover:bg-neutral-100 transition-colors duration-300"
            aria-expanded="false"
          >
            <span class="text-lg md:text-xl font-[500] text-black pr-4" style="font-family: var(--font-roobert);">
              ¿Cómo me registro para ser distribuidor?
            </span>
            <svg class="faq-chevron w-6 h-6 text-black flex-shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content hidden bg-white">
            <div class="p-6 md:p-8 text-neutral-600 leading-relaxed" style="font-family: var(--font-roobert);">
              Para registrarte como distribuidor, contáctanos por WhatsApp o correo electrónico con tus datos comerciales. Nuestro equipo evaluará tu perfil y <strong class="text-black">en un máximo de 48 horas</strong> recibirás una respuesta con los términos y condiciones para comenzar a trabajar con nosotros.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <InstagramFeed />

  <!-- CTA Section - BLACK -->
  <section class="relative py-24 md:py-28 lg:py-32 bg-black">
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-[300] text-white mb-6 tracking-[0.02em] reveal" style="font-family: var(--font-roobert);">
        ¿Listo para <span class="text-shadow-glow">iluminar</span>?
      </h2>
      <p class="text-lg md:text-xl text-neutral-400 mb-12 max-w-xl mx-auto reveal reveal-delay-1" style="font-family: var(--font-roobert);">
        Contáctanos por WhatsApp y te ayudamos a encontrar la solución perfecta para tu proyecto.
      </p>

      <a
        href="https://wa.me/584242280730?text=%C2%A1Hola!%20Quiero%20conocer%20los%20productos%20de%20iluminaci%C3%B3n%20LED%20de%20%C3%89beli"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 border border-white/30 bg-white/10 backdrop-blur-sm hover:bg-white/15 hover:border-white/50 text-white font-[600] px-14 py-6 transition-all duration-300 hover:scale-105 scale-in reveal reveal-delay-2"
        style="font-family: var(--font-roobert); border-radius: 75.024px;"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="text-lg">Hablar por WhatsApp</span>
      </a>
    </div>
  </section>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach((item) => {
      const trigger = item.querySelector('.faq-trigger') as HTMLElement | null;
      const content = item.querySelector('.faq-content') as HTMLElement | null;
      const chevron = item.querySelector('.faq-chevron') as HTMLElement | null;

      if (trigger && content && chevron) {
        trigger.addEventListener('click', () => {
          const isOpen = content.classList.contains('open');

          document.querySelectorAll('.faq-content.open').forEach((openContent) => {
            if (openContent !== content) {
              openContent.classList.remove('open');
              openContent.classList.add('hidden');
              const openParent = (openContent as HTMLElement).parentElement;
              const openChevron = openParent?.querySelector('.faq-chevron') as HTMLElement | null;
              if (openChevron) openChevron.style.transform = 'rotate(0deg)';
              const openTrigger = openParent?.querySelector('.faq-trigger') as HTMLElement | null;
              if (openTrigger) openTrigger.setAttribute('aria-expanded', 'false');
            }
          });

          if (isOpen) {
            content.classList.remove('open');
            content.classList.add('hidden');
            chevron.style.transform = 'rotate(0deg)';
            trigger.setAttribute('aria-expanded', 'false');
          } else {
            content.classList.add('open');
            content.classList.remove('hidden');
            chevron.style.transform = 'rotate(180deg)';
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      }
    });
  });
</script>
</MainLayout>
