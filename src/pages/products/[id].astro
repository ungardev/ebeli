---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { id: product.data.id || product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;

const pageTitle = `${product.data.title} | ${SITE.title}`;
const metaDescription = `Especificaciones técnicas del producto ${product.data.title}. Iluminación LED premium.`;

const categoryLabels: Record<string, string> = {
  bombillos: 'Bombillos',
  lamparas: 'Lámparas',
  tubos: 'Tubos',
  reflectores: 'Reflectores',
  cintas: 'Cintas LED',
  paneles: 'Paneles',
};

const watts = product.data.watts as number[];
---

<MainLayout title={pageTitle} customDescription={metaDescription}>

  <!-- Hero Section - Dark Luxury Visualizer -->
  <section class="relative bg-black overflow-hidden">
    <!-- Subtle radial gradient simulating LED light -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(255,250,240,0.06)_0%,transparent_50%)]"></div>
    
    <div class="relative mx-auto max-w-[1078px] px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm text-neutral-500">
        <a href="/products" class="hover:text-white transition-colors">Productos</a>
        <span class="mx-2">/</span>
        <a href={`/products?category=${product.data.category}`} class="hover:text-white transition-colors">
          {categoryLabels[product.data.category] || product.data.category}
        </a>
        <span class="mx-2">/</span>
        <span class="text-white">{product.data.title}</span>
      </nav>

      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-start">
        
        <!-- LEFT: Product Image - OLED Mate Container -->
        <div class="relative">
          <div class="sticky top-24 overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 p-8">
            <div class="relative aspect-[4/5] md:aspect-square w-full rounded-2xl bg-[#0a0a0a] border border-white/5 overflow-hidden flex items-center justify-center">
              <!-- Wrapper Anidado - guillotina interna para el zoom -->
              <div class="absolute inset-0 w-full h-full overflow-hidden flex items-center justify-center p-6">
                <Image
                  src={product.data.mainImage}
                  alt={product.data.title}
                  format="webp"
                  quality="max"
                  class:list={[
                    'max-h-full max-w-full object-contain object-center',
                    ['bombillos', 'reflectores', 'cintas'].includes(product.data.category) ? 'scale-120' : ''
                  ]}
                  loading="eager"
                />
              </div>
              <!-- Subtle glow effect on image -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Product Info -->
        <div class="flex flex-col gap-8">
          <!-- Category Badge -->
          <div>
            <span class="inline-block rounded-full bg-white/5 border border-white/10 px-4 py-1.5 text-xs font-[400] uppercase tracking-wider text-white/70">
              {categoryLabels[product.data.category] || product.data.category}
            </span>
          </div>

          <!-- Title -->
          <h1 class="text-4xl font-[300] tracking-tight text-white md:text-5xl lg:text-6xl" style="font-family: var(--font-roobert);">
            {product.data.title}
          </h1>

          <!-- Watts Badges -->
          <div class="flex flex-wrap gap-3">
            {watts.map((w) => (
              <span class="inline-flex items-center justify-center rounded-full bg-white/10 border border-white/20 px-6 py-2 text-lg font-[400] text-white">
                {w}W
              </span>
            ))}
          </div>

          <!-- Key Specs -->
          <div class="flex flex-wrap gap-6 text-neutral-400 text-sm">
            <span>Voltaje: {product.data.voltage}</span>
            <span>Temperatura: {product.data.colorTemperature}</span>
            {product.data.specs?.base && <span>Base: {product.data.specs.base}</span>}
            {product.data.specs?.shape && <span>Forma: {product.data.specs.shape}</span>}
            {product.data.specs?.flux && <span>{product.data.specs.flux}</span>}
          </div>

          <!-- Warranty Badge -->
          <div class="inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/10 px-4 py-2 text-sm text-white/70 w-fit">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>{product.data.warranty}</span>
          </div>

          <!-- CTA WhatsApp -->
          <div class="mt-8 pt-8 border-t border-white/5">
            <a
              href="https://wa.me/"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-3 bg-[#059669] hover:bg-[#047857] text-white font-[600] px-10 py-5 transition-all duration-300 hover:scale-105 border border-neutral-900"
              style="font-family: var(--font-roobert); border-radius: 75.024px;"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span class="text-lg">Solicitar Información</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specifications Table -->
  <section class="bg-black border-t border-white/5">
    <div class="mx-auto max-w-[1078px] px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <h2 class="text-3xl font-[300] text-white mb-12 text-center" style="font-family: var(--font-roobert);">
        Especificaciones Técnicas
      </h2>
      
      <div class="overflow-hidden rounded-2xl border border-white/5">
        <table class="w-full">
          <thead>
            <tr class="border-b border-white/5 bg-neutral-900/40">
              <th class="px-8 py-5 text-left text-sm font-[600] text-white uppercase tracking-wider" style="font-family: var(--font-roobert);">Característica</th>
              <th class="px-8 py-5 text-left text-sm font-[600] text-white uppercase tracking-wider" style="font-family: var(--font-roobert);">Valor</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <tr class="bg-neutral-900/20">
              <td class="px-8 py-5 text-sm font-[400] text-neutral-300" style="font-family: var(--font-roobert);">Voltaje</td>
              <td class="px-8 py-5 text-sm font-[400] text-white" style="font-family: var(--font-roobert);">{product.data.voltage}</td>
            </tr>
            <tr class="bg-transparent">
              <td class="px-8 py-5 text-sm font-[400] text-neutral-300" style="font-family: var(--font-roobert);">Temperatura de Color</td>
              <td class="px-8 py-5 text-sm font-[400] text-white" style="font-family: var(--font-roobert);">{product.data.colorTemperature}</td>
            </tr>
            <tr class="bg-neutral-900/20">
              <td class="px-8 py-5 text-sm font-[400] text-neutral-300" style="font-family: var(--font-roobert);">Potencias Disponibles</td>
              <td class="px-8 py-5 text-sm font-[400] text-white" style="font-family: var(--font-roobert);">{product.data.watts.join('W, ')}W</td>
            </tr>
            <tr class="bg-transparent">
              <td class="px-8 py-5 text-sm font-[400] text-neutral-300" style="font-family: var(--font-roobert);">Garantía</td>
              <td class="px-8 py-5 text-sm font-[400] text-white" style="font-family: var(--font-roobert);">{product.data.warranty}</td>
            </tr>
            {product.data.specs?.base && (
              <tr class="bg-neutral-900/20">
                <td class="px-8 py-5 text-sm font-[400] text-neutral-300" style="font-family: var(--font-roobert);">Base</td>
                <td class="px-8 py-5 text-sm font-[400] text-white" style="font-family: var(--font-roobert);">{product.data.specs.base}</td>
              </tr>
            )}
            {product.data.specs?.shape && (
              <tr class="bg-transparent">
                <td class="px-8 py-5 text-sm font-[400] text-neutral-300" style="font-family: var(--font-roobert);">Forma</td>
                <td class="px-8 py-5 text-sm font-[400] text-white" style="font-family: var(--font-roobert);">{product.data.specs.shape}</td>
              </tr>
            )}
            {product.data.specs?.flux && (
              <tr class="bg-neutral-900/20">
                <td class="px-8 py-5 text-sm font-[400] text-neutral-300" style="font-family: var(--font-roobert);">Flujo Luminoso</td>
                <td class="px-8 py-5 text-sm font-[400] text-white" style="font-family: var(--font-roobert);">{product.data.specs.flux}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Back to Catalog -->
  <section class="bg-[#0a0a0a] border-t border-white/5 py-16">
    <div class="mx-auto max-w-[1078px] px-4 text-center">
      <a
        href="/products"
        class="group inline-flex items-center gap-3 text-white font-[400] text-lg transition-all duration-200 hover:text-neutral-300 hover:gap-4"
        style="font-family: var(--font-roobert);"
      >
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        <span>Volver al Catálogo</span>
      </a>
    </div>
  </section>

</MainLayout>