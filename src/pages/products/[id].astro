---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';

import tecnologiaJaponesa from '@/images/certificados/tecnologia-japonesa.png';
import dosAnosGarantia from '@/images/certificados/2-anos-garantia.png';
import iso9001 from '@/images/certificados/iso-9001.png';

const certificates = [
  { image: dosAnosGarantia, label: '2 Años de Garantía' },
  { image: iso9001, label: 'ISO 9001' },
  { image: tecnologiaJaponesa, label: 'Tecnología Japonesa' },
];

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { id: product.data.id || product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;

const pageTitle = `${product.data.title} | ${SITE.title}`;
const metaDescription = `Especificaciones técnicas del producto ${product.data.title}. Iluminación LED premium.`;

const categoryLabels: Record<string, string> = {
  bombillos: 'Bombillos',
  lamparas: 'Lámparas',
  tubos: 'Tubos',
  reflectores: 'Reflectores',
  cintas: 'Cintas LED',
  paneles: 'Paneles',
};

const watts = product.data.watts as number[];

const productImageRes = await getImage({
  src: product.data.mainImage,
  width: 800,
  height: 1000,
  format: 'webp',
});
const productImageUrl = Astro.url.origin + productImageRes.src;

const subCategory = product.data.subCategory as string | undefined;

const getProductScale = (category: string, sub?: string, productId?: string) => {
  if (productId === 'bombillo-led-domo') {
    return 'object-center scale-[2.20]';
  }
  if (sub === 'dicroicos' || sub === 'velas' || sub === 'lipstick') {
    return 'object-center scale-[1.50]';
  }
  if (category === 'bombillos') {
    return 'object-center scale-[1.50]';
  }
  if (category === 'cintas') {
    return 'object-top scale-[1.20]';
  }
  if (category === 'reflectores') {
    return 'object-center scale-[1.80]';
  }
  return 'object-center';
};

const productScale = getProductScale(product.data.category, subCategory, product.id);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.data.title,
  "image": productImageUrl,
  "description": metaDescription,
  "brand": {
    "@type": "Brand",
    "name": "Ébeli"
  },
  "category": categoryLabels[product.data.category] || product.data.category,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": Astro.url.href
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Voltaje", "value": product.data.voltage },
    { "@type": "PropertyValue", "name": "Temperatura de Color", "value": product.data.colorTemperature },
    { "@type": "PropertyValue", "name": "Garantía", "value": product.data.warranty }
  ]
};
---

<MainLayout title={pageTitle} customDescription={metaDescription} structuredData={productSchema}>

  <!-- Hero Section - Dark Luxury Visualizer -->
  <section class="relative bg-black overflow-hidden pt-[60px] md:pt-0">
    <!-- Subtle radial gradient simulating LED light -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(255,250,240,0.06)_0%,transparent_50%)]"></div>
    
    <div class="relative mx-auto max-w-[1078px] px-4 py-10 sm:px-6 lg:px-8 lg:py-20">
      
      <!-- Breadcrumb - Ultra Minimalist -->
      <nav class="mb-4 flex items-center gap-1.5 text-xs tracking-wide text-white/30" aria-label="Breadcrumb">
        <a href="/products" class="hover:text-white/70 transition-colors duration-200 ease-out">Productos</a>
        <svg class="w-3 h-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
        </svg>
        <a href={`/products?category=${product.data.category}`} class="hover:text-white/70 transition-colors duration-200 ease-out">
          {categoryLabels[product.data.category] || product.data.category}
        </a>
        <svg class="w-3 h-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
        </svg>
        <span class="text-white/60">{product.data.title}</span>
      </nav>

      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12 items-start">
        
        <!-- LEFT: Product Image - OLED Mate Container -->
        <div class="relative">
          <div class="sticky top-24 overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 p-6 lg:p-8">
            <div class="relative aspect-[4/5] md:aspect-square w-full rounded-2xl bg-[#0a0a0a] border border-white/5 overflow-hidden flex items-center justify-center">
              <!-- Wrapper Anidado - guillotina interna para el zoom -->
              <div class="absolute inset-0 w-full h-full overflow-hidden flex items-center justify-center p-2 lg:p-2">
                <Image
                  src={product.data.mainImage}
                  alt={product.data.title}
                  format="webp"
                  quality={85}
                  class:list={[
                  'max-h-full max-w-full object-contain transition-transform duration-500',
                  productScale
                ]}
                  loading="eager"
                />
              </div>
              <!-- Subtle glow effect on image -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Product Info -->
        <div class="flex flex-col gap-7">
          <!-- Category Badge -->
          <div>
            <span class="inline-block rounded-full bg-white/5 border border-white/10 px-4 py-1.5 text-xs font-[400] uppercase tracking-wider text-white/60">
              {categoryLabels[product.data.category] || product.data.category}
            </span>
          </div>

          <!-- Title -->
          <h1 class="text-4xl font-[300] tracking-tight text-white md:text-5xl lg:text-6xl" style="font-family: var(--font-roobert);">
            {product.data.title}
          </h1>

          <!-- Watts Badges -->
          <div class="flex flex-wrap gap-3">
            {watts.map((w) => (
              <span class="inline-flex items-center justify-center rounded-full bg-white/10 border border-white/20 px-6 py-2 text-lg font-[600] text-white">
                {w}W
              </span>
            ))}
          </div>

          <!-- Key Specs - Premium readability -->
          <div class="flex flex-col gap-4 text-base text-neutral-300">
            {product.data.specs?.flux && (
              <div class="flex items-center gap-2">
                <span class="w-1 h-1 bg-white/30 rounded-full"></span>
                <span class="text-sm">{product.data.specs.flux}</span>
              </div>
            )}
            <div class="flex items-center gap-2">
              <span class="w-1 h-1 bg-white/30 rounded-full"></span>
              <span>Voltaje: <strong class="font-[600] text-white">{product.data.voltage}</strong></span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1 h-1 bg-white/30 rounded-full"></span>
              <span>Temperatura: <strong class="font-[600] text-white">{product.data.colorTemperature}</strong></span>
            </div>
            {product.data.specs?.base && (
              <div class="flex items-center gap-2">
                <span class="w-1 h-1 bg-white/30 rounded-full"></span>
                <span>Base: <strong class="font-[600] text-white">{product.data.specs.base}</strong></span>
              </div>
            )}
            {product.data.specs?.shape && (
              <div class="flex items-center gap-2">
                <span class="w-1 h-1 bg-white/30 rounded-full"></span>
                <span>Forma: <strong class="font-[600] text-white">{product.data.specs.shape}</strong></span>
              </div>
            )}
          </div>

          <!-- Warranty Badge -->
          <div class="inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/10 px-4 py-2 text-sm text-white/70 w-fit">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>{product.data.warranty}</span>
          </div>

          <!-- CTA WhatsApp -->
          <div class="mt-0 pt-4 border-t border-white/5">
            <a
              href="https://wa.me/584242280730?text=%C2%A1Hola!%20Quiero%20conocer%20los%20productos%20de%20iluminaci%C3%B3n%20LED%20de%20%C3%89beli"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-3 bg-[#059669] hover:bg-[#047857] text-white font-[600] px-10 py-5 transition-all duration-300 hover:scale-105 border border-neutral-900"
              style="font-family: var(--font-roobert); border-radius: 75.024px;"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span class="text-lg">Solicitar Información</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certificates / Quality Badges - Full Width Above Specs -->
  <div class="mx-auto max-w-[1078px] px-4">
    <div class="flex flex-row items-center justify-center gap-1 py-0 md:gap-4 md:py-0">
      {certificates.map((cert) => (
        <Image
          src={cert.image}
          alt={cert.label}
          class="h-56 w-auto object-contain md:h-108"
          loading="lazy"
        />
      ))}
    </div>
  </div>

  <div class="mx-auto max-w-[1078px] px-4">
    <div class="mt-0 lg:mt-0 border-t border-white/5 pt-3">
      
      <!-- Section Title - Imposing with gradient indicator -->
      <div class="mb-6 flex items-center gap-4">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
        <div class="flex items-center gap-3">
          <span class="w-1.5 h-8 bg-gradient-to-b from-white/80 to-white/20 rounded-full block"></span>
          <h3 class="text-xl md:text-2xl lg:text-3xl font-[400] tracking-wide text-white uppercase" style="font-family: var(--font-roobert);">
            Especificaciones de Ingeniería
          </h3>
        </div>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
        
        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm p-5 lg:p-6 rounded-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <p class="text-xs lg:text-sm font-[400] uppercase tracking-widest text-white/70 mb-2">Flujo Luminoso</p>
          <p class="text-lg lg:text-xl font-[600] text-white">{product.data.specs?.flux || "—"}</p>
        </div>

        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm p-5 lg:p-6 rounded-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <p class="text-xs lg:text-sm font-[400] uppercase tracking-widest text-white/70 mb-2">Potencia</p>
          <p class="text-lg lg:text-xl font-[600] text-white">
            {product.data.watts ? product.data.watts.join('W / ') + 'W' : '—'}
          </p>
        </div>

        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm p-5 lg:p-6 rounded-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <p class="text-xs lg:text-sm font-[400] uppercase tracking-widest text-white/70 mb-2">Voltaje</p>
          <p class="text-lg lg:text-xl font-[600] text-white">{product.data.voltage || '—'}</p>
        </div>

        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm p-5 lg:p-6 rounded-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <p class="text-xs lg:text-sm font-[400] uppercase tracking-widest text-white/70 mb-2">Temperatura</p>
          <p class="text-lg lg:text-xl font-[600] text-white">{product.data.colorTemperature || '—'}</p>
        </div>

        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm p-5 lg:p-6 rounded-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <p class="text-xs lg:text-sm font-[400] uppercase tracking-widest text-white/70 mb-2">Ángulo</p>
          <p class="text-lg lg:text-xl font-[600] text-white">{product.data.category === 'bombillos' ? '230°' : '120°'}</p>
        </div>

        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm p-5 lg:p-6 rounded-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <p class="text-xs lg:text-sm font-[400] uppercase tracking-widest text-white/70 mb-2">Material</p>
          <p class="text-lg lg:text-xl font-[600] text-white uppercase">{product.data.category === 'reflectores' ? 'Al + Vidrio' : 'Plástico'}</p>
        </div>

        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm p-5 lg:p-6 rounded-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <p class="text-xs lg:text-sm font-[400] uppercase tracking-widest text-white/70 mb-2">Protección</p>
          <p class="text-lg lg:text-xl font-[600] text-white">{product.data.category === 'reflectores' ? 'IP66' : 'IP20'}</p>
        </div>

        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm p-5 lg:p-6 rounded-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <p class="text-xs lg:text-sm font-[400] uppercase tracking-widest text-white/70 mb-2">Garantía</p>
          <p class="text-lg lg:text-xl font-[600] text-white">{product.data.warranty || '2 Años'}</p>
        </div>

      </div>

      <div class="mt-5 flex items-center gap-3">
        <div class="bg-[#0a0a0a]/60 backdrop-blur-sm px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
          <svg class="w-4 h-4 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="text-xs font-[400] uppercase tracking-widest text-white/50">Vida Útil:</span>
          <span class="text-sm font-[600] text-white/80">25,000 hrs bajo Calidad Tipo A</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Back to Catalog -->
  <section class="bg-[#0a0a0a] border-t border-white/5 py-16">
    <div class="mx-auto max-w-[1078px] px-4 text-center">
      <a
        href="/products"
        class="group inline-flex items-center gap-3 text-white/50 font-[400] text-base transition-all duration-200 hover:text-white hover:gap-4"
        style="font-family: var(--font-roobert);"
      >
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        <span>Volver al Catálogo</span>
      </a>
    </div>
  </section>

</MainLayout>