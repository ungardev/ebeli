---
import MainLayout from '@/layouts/MainLayout.astro';
import '@styles/reveal.css';
import { getCollection } from 'astro:content';
import ProductCard from '@components/ui/cards/ProductCard.astro';

const products = await getCollection('products');

const categories = [
  { id: 'bombillos', label: 'Bombillos' },
  { id: 'lamparas', label: 'Lámparas' },
  { id: 'tubos', label: 'Tubos' },
  { id: 'reflectores', label: 'Reflectores' },
  { id: 'cintas', label: 'Cintas LED' },
  { id: 'paneles', label: 'Paneles' },
];

const pageTitle = 'CATÁLOGO | Ébeli';
const metaDescription = 'Explora el catálogo completo de iluminación LED Ébeli. Bombillos, lámparas, tubos, reflectores, cintas y paneles de alta eficiencia.';
---

<MainLayout title={pageTitle} customDescription={metaDescription}>
  
  <!-- Hero Section -->
  <section class="relative bg-black py-20 md:py-24 lg:py-28">
    <div class="mx-auto max-w-[1078px] px-4 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-[300] text-white uppercase tracking-[0.15em] mb-4" style="font-family: var(--font-roobert);">
        CATÁLOGO
      </h1>
      <p class="text-xl md:text-2xl text-neutral-400 uppercase tracking-[0.1em]" style="font-family: var(--font-roobert);">
        ILUMINACIÓN LED PREMIUM
      </p>
    </div>
  </section>

  <!-- Main Catalog Section -->
  <section class="bg-[#0a0a0a] py-16 md:py-20 lg:py-24">
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-10 lg:gap-16">
        
        <!-- LEFT COLUMN: Filters Sidebar (Sticky) -->
        <aside class="lg:sticky lg:top-24 lg:self-start space-y-8">
          
          <!-- Category Filters -->
          <div class="bg-[#0a0a0a] border border-white/5 rounded-2xl p-6">
            <h3 class="text-sm font-[600] text-white uppercase tracking-wider mb-4" style="font-family: var(--font-roobert);">
              Categorías
            </h3>
            <div class="space-y-3" id="category-filters">
              {categories.map((cat) => (
                <label class="flex items-center gap-3 cursor-pointer group">
                  <input
                    type="checkbox"
                    class="category-checkbox w-5 h-5 rounded border-white/20 bg-white/5 checked:bg-white checked:border-white transition-colors duration-200"
                    data-category={cat.id}
                  />
                  <span class="text-sm text-white/70 group-hover:text-white transition-colors duration-200" style="font-family: var(--font-roobert);">
                    {cat.label}
                  </span>
                </label>
              ))}
            </div>
          </div>

          <!-- Download Catalog Button -->
          <a
            href="/CATÁLOGO OCTUBRE.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 bg-white text-black font-[600] px-8 py-5 rounded-full transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_30px_rgba(255,255,255,0.15)] w-full"
            style="font-family: var(--font-roobert);"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Descargar Catálogo PDF</span>
          </a>

        </aside>

        <!-- RIGHT COLUMN: Products Grid -->
        <div class="space-y-6">
          <!-- Results Count -->
          <div class="flex items-center justify-between">
            <p class="text-sm text-neutral-500" id="results-count" style="font-family: var(--font-roobert);">
              Mostrando <span id="count">{products.length}</span> productos
            </p>
          </div>

          <!-- Products Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="products-grid">
            {products.map((product) => (
              <div class="product-item" data-category={product.data.category}>
                <ProductCard product={product} />
              </div>
            ))}
          </div>

          <!-- Empty State -->
          <div id="empty-state" class="hidden text-center py-16">
            <svg class="w-16 h-16 mx-auto text-neutral-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-neutral-400 text-lg" style="font-family: var(--font-roobert);">
              No se encontraron productos en esta categoría
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 md:py-28 lg:py-32 bg-black">
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-[300] text-white mb-6 tracking-[0.02em]" style="font-family: var(--font-roobert);">
        ¿Listo para <span class="text-shadow-glow">iluminar</span>?
      </h2>
      <p class="text-lg md:text-xl text-neutral-400 mb-12 max-w-xl mx-auto" style="font-family: var(--font-roobert);">
        Contáctanos por WhatsApp y te ayudamos a encontrar la solución perfecta para tu proyecto.
      </p>
      <a
        href="https://wa.me/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#059669] hover:bg-[#047857] text-white font-[600] px-14 py-6 transition-all duration-300 hover:scale-105 border border-neutral-900"
        style="font-family: var(--font-roobert); border-radius: 75.024px;"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="text-lg">Hablar por WhatsApp</span>
      </a>
    </div>
  </section>

</MainLayout>

<script is:inline>
  (function() {
    const checkboxes = document.querySelectorAll('.category-checkbox');
    const items = document.querySelectorAll('.product-item');
    const countEl = document.getElementById('count');
    const emptyState = document.getElementById('empty-state');

    function filterProducts() {
      const activeCategories = Array.from(checkboxes)
        .filter(cb => cb.checked)
        .map(cb => cb.dataset.category);

      let visibleCount = 0;

      items.forEach(item => {
        const category = item.dataset.category;
        if (activeCategories.length === 0 || activeCategories.includes(category)) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = visibleCount.toString();
      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', filterProducts);
    });
  })();
</script>