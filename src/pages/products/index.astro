---
import MainLayout from '@/layouts/MainLayout.astro';
import '@styles/reveal.css';
import { getCollection } from 'astro:content';
import ProductCard from '@components/ui/cards/ProductCard.astro';

const products = await getCollection('products');

const categories = [
  { id: 'bombillos', label: 'Bombillos' },
  { id: 'lamparas', label: 'Lámparas' },
  { id: 'tubos', label: 'Tubos' },
  { id: 'reflectores', label: 'Reflectores' },
  { id: 'cintas', label: 'Cintas LED' },
  { id: 'paneles', label: 'Paneles' },
];

const pageTitle = 'CATÁLOGO | Ébeli';
const metaDescription = 'Explora el catálogo completo de iluminación LED Ébeli. Bombillos, lámparas, tubos, reflectores, cintas y paneles de alta eficiencia.';
---

<MainLayout title={pageTitle} customDescription={metaDescription}>
  
  <!-- Hero Section - Premium Dark Gradient -->
  <section class="relative pt-[88px] pb-12 md:pt-24 md:pb-20 border-b border-white/5 bg-gradient-to-b from-[#0a0a0a] to-[#050505]">
    <div class="max-w-7xl mx-auto px-4 text-center md:text-left">
      <h1 class="text-5xl md:text-7xl font-[300] tracking-tight text-white mb-5" style="font-family: var(--font-roobert);">
        CATÁLOGO DE PRODUCTOS
      </h1>
      <p class="text-xl md:text-2xl text-white/90 max-w-2xl font-[300] leading-relaxed" style="font-family: var(--font-roobert);">
        Soluciones de iluminación LED de alta ingeniería, diseñadas para proyectos residenciales, comerciales e industriales.
      </p>

      <!-- Search Bar -->
      <div class="mt-8 max-w-2xl w-full mx-auto md:mx-0 relative group">
        <div class="absolute inset-0 bg-white/5 rounded-xl blur-sm group-focus-within:bg-white/10 transition-all duration-300"></div>
        <div class="relative flex items-center bg-[#0d0d0d] border border-white/10 group-focus-within:border-white/30 rounded-xl transition-all duration-300 shadow-2xl">
          <div class="pl-4 pr-2 text-white/40 group-focus-within:text-white/80 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="product-search"
            placeholder="¿Qué buscas hoy? (Ej. Reflector, Bombillo, etc)"
            class="w-full py-4 bg-transparent text-white placeholder-white/70 text-base font-medium focus:outline-none focus:ring-0 border-none rounded-xl pr-12 transition-all"
            autocomplete="off"
          />
          <button
            type="button"
            id="clear-search-btn"
            class="absolute right-4 text-white/40 hover:text-white hidden transition-all p-1 rounded-md hover:bg-white/5"
            aria-label="Limpiar búsqueda"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Catalog Section -->
  <section class="bg-[#050505] py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 items-start">
        
        <!-- LEFT COLUMN: Filters Sidebar -->
        <aside class="w-full md:w-72">
          <div id="filters-panel" class="bg-[#0a0a0a] p-6 rounded-2xl border border-white/5 shadow-2xl md:sticky md:top-24 space-y-6">

            <div
              id="filters-toggle"
              class="flex items-center justify-between cursor-pointer md:cursor-default select-none group"
            >
              <h2 class="text-base md:text-lg font-[600] tracking-wide text-white flex items-center gap-2" style="font-family: var(--font-roobert);">
                <span class="w-1.5 h-4 bg-white rounded-full block"></span>
                Filtrar Categorías
              </h2>
              <svg
                id="filters-chevron"
                class="w-7 h-7 text-white/60 transition-transform duration-300 md:hidden bg-white/5 p-1 rounded-md border border-white/10 group-hover:bg-white/10"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>

            <div id="filters-content" class="hidden md:block space-y-2 transition-all duration-300">
              {categories.map((cat) => (
                <label class="flex items-center justify-between p-3 rounded-xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] hover:border-white/20 transition-all duration-300 cursor-pointer group">
                  <span class="group-hover:translate-x-1 transition-transform duration-300 text-base font-[600] text-white" style="font-family: var(--font-roobert);">
                    {cat.label}
                  </span>
                  <input
                    type="checkbox"
                    class="category-checkbox w-5 h-5 rounded-md border-2 border-white/20 bg-transparent text-white checked:bg-white checked:border-white focus:ring-0 focus:ring-offset-0 transition-all cursor-pointer accent-white"
                    data-category={cat.id}
                  />
                </label>
              ))}

              <div class="pt-4 border-t border-white/5">
                <a
                  href="/CATÁLOGO OCTUBRE.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-3 w-full py-4 px-4 bg-white text-black hover:bg-neutral-200 font-[600] rounded-xl transition-all duration-300 text-sm tracking-wider uppercase shadow-lg shadow-white/5 group"
                  style="font-family: var(--font-roobert);"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  Descargar Catálogo PDF
                </a>
              </div>
            </div>

          </div>
        </aside>

        <!-- RIGHT COLUMN: Products Grid -->
        <main class="md:col-span-3 space-y-6">
          <!-- Results Count -->
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <p class="text-sm font-medium tracking-wider text-white/70" style="font-family: var(--font-roobert);">
              Mostrando <span id="count" class="text-white font-bold text-base">{products.length}</span> soluciones de iluminación
            </p>
          </div>

          <!-- Products Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="products-grid">
            {products.map((product) => (
              <div class="product-item" data-category={product.data.category} data-title={product.data.title}>
                <ProductCard product={product} />
              </div>
            ))}
          </div>

          <!-- Empty State -->
          <div id="catalog-empty-state" class="hidden text-center py-16">
            <svg class="w-16 h-16 mx-auto text-neutral-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-neutral-400 text-lg" style="font-family: var(--font-roobert);">
              No se encontraron productos en esta categoría
            </p>
          </div>
        </main>

      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 md:py-28 lg:py-32 bg-black">
    <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-[300] text-white mb-6 tracking-[0.02em]" style="font-family: var(--font-roobert);">
        ¿Listo para <span class="text-shadow-glow">iluminar</span>?
      </h2>
      <p class="text-lg md:text-xl text-neutral-400 mb-12 max-w-xl mx-auto" style="font-family: var(--font-roobert);">
        Contáctanos por WhatsApp y te ayudamos a encontrar la solución perfecta para tu proyecto.
      </p>
      <a
        href="https://wa.me/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#059669] hover:bg-[#047857] text-white font-[600] px-14 py-6 transition-all duration-300 hover:scale-105 border border-neutral-900"
        style="font-family: var(--font-roobert); border-radius: 75.024px;"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="text-lg">Hablar por WhatsApp</span>
      </a>
    </div>
  </section>

</MainLayout>

<script is:inline>
  (function() {
    const checkboxes = document.querySelectorAll('.category-checkbox');
    const searchInput = document.getElementById('product-search');
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const productItems = document.querySelectorAll('.product-item');
    const countEl = document.getElementById('count');
    const emptyState = document.getElementById('catalog-empty-state');

    const categoryLabels = {
      bombillos: 'bombillo',
      lamparas: 'lampara',
      tubos: 'tubo',
      reflectores: 'reflector',
      cintas: 'cinta',
      paneles: 'panel',
    };

    function filterProducts() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const activeCategories = Array.from(checkboxes)
        .filter(cb => cb.checked)
        .map(cb => cb.dataset.category);

      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('hidden', query.length === 0);
      }

      let visibleCount = 0;

      productItems.forEach((item) => {
        const productTitle = (item.getAttribute('data-title') || '').toLowerCase();
        const productCategory = (item.getAttribute('data-category') || '').toLowerCase();
        const categoryKeyword = categoryLabels[productCategory] || productCategory;

        const matchesCategory = activeCategories.length === 0 || activeCategories.includes(productCategory);
        const matchesSearch = query === '' ||
          productTitle.includes(query) ||
          productCategory.includes(query) ||
          categoryKeyword.includes(query);

        if (matchesCategory && matchesSearch) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = visibleCount.toString();
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', filterProducts);
    });

    if (searchInput) {
      searchInput.addEventListener('input', filterProducts);
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          filterProducts();
          searchInput.focus();
        }
      });
    }

    const filtersToggle = document.getElementById('filters-toggle');
    const filtersContent = document.getElementById('filters-content');
    const filtersChevron = document.getElementById('filters-chevron');

    if (filtersToggle && filtersContent) {
      filtersToggle.addEventListener('click', () => {
        if (window.innerWidth < 768) {
          const isCollapsed = filtersContent.classList.contains('hidden');

          if (isCollapsed) {
            filtersContent.classList.remove('hidden');
            if (filtersChevron) filtersChevron.style.transform = 'rotate(180deg)';
          } else {
            filtersContent.classList.add('hidden');
            if (filtersChevron) filtersChevron.style.transform = 'rotate(0deg)';
          }
        }
      });
    }
  })();
</script>