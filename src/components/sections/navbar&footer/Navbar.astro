---
import NavLink from '@components/ui/links/NavLink.astro';
import enStrings from '@utils/navigation.ts';

const strings = enStrings;
const homeUrl = '/';
---

<!-- Navbar wrapper - Premium floating container -->
<div id="navbar-main" class="navbar-wrapper fixed md:sticky top-4 z-50 px-4 w-full transition-all duration-300 ease-in-out" data-lenis-prevent>
  <header class="header-navbar relative rounded-2xl bg-[#0a0a0a] md:bg-[#0a0a0a]/95 md:backdrop-blur-xl border border-white/5 shadow-[0_0_40px_rgba(0,0,0,0.5)] w-full">
    <nav
      class="flex items-center justify-between px-2 py-4 md:px-6 md:pr-16 md:py-1.5"
      aria-label="Global"
    >
      <div class="flex items-center justify-center w-full md:justify-between">
        <a
          class="text-center md:relative md:left-auto md:translate-x-0 md:flex-none rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3 dark:ring-zinc-200 dark:focus:outline-hidden"
          href={homeUrl}
          aria-label="Brand"
        >
          <div class="flex items-center justify-center -mx-2 md:-mx-2">
            <img src="/apple-touch-icon.png" alt="Ébeli" class="hidden md:block h-14 w-auto object-contain" />
            <img src="/ebeli-fuente.png" alt="Ébeli" class="h-[28px] md:h-[34px] w-auto object-contain" />
          </div>
        </a>
        
        <!-- Desktop Navigation Links - Premium spacing + animated underline -->
        <div class="hidden md:flex items-center gap-12 lg:gap-16">
          {
            strings.navBarLinks.map(link => (
              <NavLink url={link.url} name={link.name} customClass="nav-link-premium" />
            ))
          }
        </div>
        
        <!-- Mobile menu button - right aligned -->
        <button
          type="button"
          class="md:hidden absolute right-0 flex h-13 w-13 items-center justify-center rounded-full text-white transition-all duration-200 hover:bg-white/10 focus:outline-hidden"
          data-mobile-menu-toggle
          aria-controls="navbar-collapse-with-animation"
          aria-label="Toggle navigation"
          aria-expanded="false"
        >
            <svg
              class="menu-open h-6 w-6 shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" x2="21" y1="6" y2="6"></line>
              <line x1="3" x2="21" y1="12" y2="12"></line>
              <line x1="3" x2="21" y1="18" y2="18"></line>
            </svg>
            <svg
              class="menu-close hidden h-6 w-6 shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation - Overlay with slide animation -->
    <div
      id="navbar-collapse-with-animation"
      class="hidden absolute top-full -left-[1px] -right-[1px] w-[calc(100%+2px)] z-40 md:hidden navbar-mobile-menu"
    >
      <div class="bg-[#0a0a0a] rounded-t-none rounded-b-2xl border-t border-white/5 px-3 py-4">
        <div class="flex flex-col gap-5">
          {
            strings.navBarLinks.map(link => (
              <NavLink url={link.url} name={link.name} customClass="mobile-nav-link" />
            ))
          }
        </div>
      </div>
    </div>
  </header>
</div>

<style>
  /* Premium nav link with animated underline */
  :global(.nav-link-premium) {
    position: relative;
    padding: 0.375rem 0;
    color: #8d8d8d !important;
    font-weight: 400;
    font-size: 1.125rem;
    transition: color 0.2s ease;
  }
  
  :global(.nav-link-premium:hover) {
    color: #ffffff !important;
  }
  
  :global(.nav-link-premium[aria-current="page"]) {
    color: #ffffff !important;
  }
  
  /* Mobile nav link */
  :global(.mobile-nav-link) {
    padding: 1rem 0;
    font-size: 1.75rem;
    font-weight: 400;
    color: #ffffff !important;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  :global(.mobile-nav-link:last-child) {
    border-bottom: none;
  }

  /* Mobile menu slide down animation */
  .navbar-mobile-menu {
    animation: slideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Navbar states for mobile */
  @media (max-width: 767px) {
    .navbar-wrapper {
      transition: all 0.3s ease-in-out;
    }
    
    /* At top - transparent blends into Hero gradient */
    .navbar-wrapper.at-top .header-navbar {
      background: transparent !important;
      backdrop-filter: none !important;
      border-color: transparent !important;
      box-shadow: none !important;
    }
    
    /* Solid state - dark premium background when scrolled or menu open */
    .navbar-wrapper.navbar-solid .header-navbar {
      background: rgba(10, 10, 10, 0.95) !important;
      backdrop-filter: blur(12px) !important;
      border-color: rgba(255, 255, 255, 0.05) !important;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.5) !important;
    }
    
    /* Hidden state - scroll down hides navbar */
    .navbar-wrapper.navbar-hidden {
      transform: translateY(-120%);
      opacity: 0;
    }
    
    /* Header rounded corners when menu is open */
    .header-navbar.menu-open {
      border-radius: 0.625rem 0.625rem 0 0;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.getElementById('navbar-main');
    const mobileMenuBtn = document.querySelector('[data-mobile-menu-toggle]');
    const mobileMenuDropdown = document.getElementById('navbar-collapse-with-animation');
    const headerNavbar = document.querySelector('.header-navbar');
    
    if (!navbar || !mobileMenuBtn || !mobileMenuDropdown || !headerNavbar) return;
    
    const nav = navbar as HTMLElement;
    const menuDropdown = mobileMenuDropdown as HTMLElement;
    const menuBtn = mobileMenuBtn as HTMLButtonElement;
    const header = headerNavbar as HTMLElement;
    let lastScrollY = window.scrollY;

    function updateNavbarState() {
      const currentScrollY = window.scrollY;
      const isMenuOpen = menuDropdown.classList.contains('menu-open');
      const isHomepage = window.location.pathname === '/';

      if (isMenuOpen) {
        nav.classList.remove('at-top', 'navbar-hidden');
        nav.classList.add('navbar-solid');
        lastScrollY = currentScrollY;
        return;
      }

      if (isHomepage && currentScrollY <= 10) {
        nav.classList.remove('navbar-solid', 'navbar-hidden');
        nav.classList.add('at-top');
      } else if (isHomepage && currentScrollY > lastScrollY && currentScrollY > 100) {
        nav.classList.remove('at-top', 'navbar-solid');
        nav.classList.add('navbar-hidden');
      } else if (isHomepage) {
        nav.classList.remove('at-top', 'navbar-hidden');
        nav.classList.add('navbar-solid');
      } else {
        nav.classList.remove('at-top', 'navbar-hidden');
        nav.classList.add('navbar-solid');
      }

      lastScrollY = currentScrollY;
    }

    menuBtn.addEventListener('click', () => {
      const isOpen = menuDropdown.classList.contains('menu-open');
      menuDropdown.classList.toggle('menu-open');
      header.classList.toggle('menu-open');
      menuBtn.setAttribute('aria-expanded', String(!isOpen));
      updateNavbarState();
    });

    window.addEventListener('scroll', updateNavbarState, { passive: true });
    updateNavbarState();
  });
</script>