---
import NavLink from '@components/ui/links/NavLink.astro';
import enStrings from '@utils/navigation.ts';
import BrandLogo from '@components/BrandLogo.astro';

const strings = enStrings;
const homeUrl = '/';
---

<!-- Navbar wrapper - floating rounded container with backdrop blur - Brand: deep-shadow bg -->
<div class="sticky top-4 z-50 px-4">
  <header class="rounded-[36px] bg-[#181818]/90 backdrop-blur-xl border border-white/10">
    <nav
      class="flex items-center justify-between px-5 py-4 md:px-6 lg:px-8"
      aria-label="Global"
    >
      <div class="flex items-center justify-center md:justify-between w-full">
        <!-- Brand logo -->
        <a
          class="flex-none rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3 dark:ring-zinc-200 dark:focus:outline-hidden md:flex-1"
          href={homeUrl}
          aria-label="Brand"
        >
          <BrandLogo class="h-auto w-24 mx-auto md:mx-0" />
        </a>
        
        <!-- Desktop Navigation Links - WHITE TEXT -->
        <div class="hidden md:flex items-center gap-6 lg:gap-8">
          {
            strings.navBarLinks.map(link => (
              <NavLink url={link.url} name={link.name} />
            ))
          }
        </div>
        
        <!-- Mobile menu button - WHITE ICON (Lighter, no HSCollapse) -->
        <div class="flex items-center md:hidden">
          <button
            type="button"
            class="flex h-10 w-10 items-center justify-center rounded-full text-white transition-colors hover:bg-neutral-800 focus:outline-hidden"
            data-mobile-menu-toggle
            aria-controls="navbar-collapse-with-animation"
            aria-label="Toggle navigation"
            aria-expanded="false"
          >
            <svg
              class="menu-open h-5 w-5 shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" x2="21" y1="6" y2="6"></line>
              <line x1="3" x2="21" y1="12" y2="12"></line>
              <line x1="3" x2="21" y1="18" y2="18"></line>
            </svg>
            <svg
              class="menu-close hidden h-5 w-5 shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Navigation (lightweight JS toggle) -->
    <div
      id="navbar-collapse-with-animation"
      class="hidden w-full overflow-hidden md:hidden"
    >
      <div class="flex flex-col gap-4 px-5 py-6 border-t border-white/10">
        {
          strings.navBarLinks.map(link => (
            <NavLink url={link.url} name={link.name} />
          ))
        }
      </div>
    </div>
  </header>
</div>