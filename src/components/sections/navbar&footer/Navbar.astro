---
import NavLink from '@components/ui/links/NavLink.astro';
import enStrings from '@utils/navigation.ts';

const strings = enStrings;
const homeUrl = '/';
---

<!-- Navbar wrapper - Premium floating container -->
<div class="sticky top-4 z-50 px-4">
  <header class="relative rounded-2xl bg-[#0a0a0a]/95 backdrop-blur-xl border border-white/5 shadow-[0_0_40px_rgba(0,0,0,0.5)]">
    <nav
      class="flex items-center justify-between px-0 py-0 md:px-4 md:py-3"
      aria-label="Global"
    >
      <div class="flex items-center justify-between w-full">
        <!-- Mobile: Logo centered via absolute positioning -->
        <div class="flex-1 md:flex-none flex justify-center">
          <a
            class="flex-none rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3 dark:ring-zinc-200 dark:focus:outline-hidden"
            href={homeUrl}
            aria-label="Brand"
          >
            <img src="/ebeli-fuente.png" alt="Ébeli" class="h-auto w-48 md:w-80" />
          </a>
        </div>
        
        <!-- Desktop Navigation Links - Premium spacing + animated underline -->
        <div class="hidden md:flex items-center gap-12 lg:gap-16">
          {
            strings.navBarLinks.map(link => (
              <NavLink url={link.url} name={link.name} customClass="nav-link-premium" />
            ))
          }
        </div>
        
        <!-- Mobile menu button - right aligned -->
        <div class="md:hidden w-full">
          <button
            type="button"
            class="flex h-13 w-13 ml-auto items-center justify-center rounded-full text-white transition-all duration-200 hover:bg-white/10 focus:outline-hidden"
            data-mobile-menu-toggle
            aria-controls="navbar-collapse-with-animation"
            aria-label="Toggle navigation"
            aria-expanded="false"
          >
            <svg
              class="menu-open h-6 w-6 shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" x2="21" y1="6" y2="6"></line>
              <line x1="3" x2="21" y1="12" y2="12"></line>
              <line x1="3" x2="21" y1="18" y2="18"></line>
            </svg>
            <svg
              class="menu-close hidden h-6 w-6 shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Navigation - Overlay with slide animation -->
    <div
      id="navbar-collapse-with-animation"
      class="hidden absolute top-full left-0 right-0 z-40 md:hidden navbar-mobile-menu"
    >
      <div class="bg-[#0a0a0a]/98 backdrop-blur-xl border-t border-white/5 px-3 py-4">
        <div class="flex flex-col gap-5">
          {
            strings.navBarLinks.map(link => (
              <NavLink url={link.url} name={link.name} customClass="mobile-nav-link" />
            ))
          }
        </div>
      </div>
    </div>
  </header>
</div>

<style>
  /* Premium nav link with animated underline */
  :global(.nav-link-premium) {
    position: relative;
    padding: 0.375rem 0;
    color: #8d8d8d !important;
    font-weight: 400;
    font-size: 1.125rem;
    transition: color 0.2s ease;
  }
  
  :global(.nav-link-premium::after) {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, #FFFAF0, rgba(255,250,240,0.3));
    transition: width 0.2s ease;
  }
  
  :global(.nav-link-premium:hover) {
    color: #ffffff !important;
  }
  
  :global(.nav-link-premium:hover::after) {
    width: 100%;
  }
  
  :global(.nav-link-premium[aria-current="page"]) {
    color: #ffffff !important;
  }
  
  :global(.nav-link-premium[aria-current="page"]::after) {
    width: 100%;
  }
  
  /* Mobile nav link */
  :global(.mobile-nav-link) {
    padding: 1rem 0;
    font-size: 1.75rem;
    font-weight: 400;
    color: #ffffff !important;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  :global(.mobile-nav-link:last-child) {
    border-bottom: none;
  }

  /* Mobile menu slide down animation */
  .navbar-mobile-menu {
    animation: slideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>