---
import { getCollection } from 'astro:content';
import ProductCard from '@components/ui/cards/ProductCard.astro';

const allProducts = await getCollection('products');

const getTopProductByCategory = (products: typeof allProducts, category: string) => {
  const filtered = products.filter((p) => p.data.category === category);
  if (filtered.length === 0) return null;
  return filtered.reduce((top, p) => {
    const topWatts = top.data.watts as number[];
    const pWatts = p.data.watts as number[];
    return Math.max(...pWatts) > Math.max(...topWatts) ? p : top;
  });
};

const categories = [
  { id: 'bombillos', label: 'Bombillos' },
  { id: 'lamparas', label: 'Lámparas' },
  { id: 'tubos', label: 'Tubos' },
  { id: 'reflectores', label: 'Reflectores' },
  { id: 'cintas', label: 'Cintas' },
  { id: 'paneles', label: 'Paneles' },
];

const featuredProducts = categories
  .map((cat) => getTopProductByCategory(allProducts, cat.id))
  .filter(Boolean) as typeof allProducts;
---

<section class="py-20 md:py-24 lg:py-28 bg-black">
  <div class="mx-auto max-w-[1078px] px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-8 md:mb-10">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-[300] text-white mb-6 md:mb-8 tracking-[0.02em] reveal" style="font-family: var(--font-roobert);">
        Productos Destacados
      </h2>
      <p class="text-xl md:text-2xl text-white/80 mb-10 md:mb-14 reveal reveal-delay-1">
        Iluminación LED premium para cada espacio
      </p>
    </div>

    <!-- Category Tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12 reveal reveal-delay-2" id="category-tabs">
      {categories.map((cat) => (
        <button
          type="button"
          class="category-tab px-6 py-2.5 rounded-full text-base md:text-lg font-[400] transition-all duration-200 bg-white/5 text-white/80 border border-white/10 hover:bg-white/10 hover:text-white"
          data-category={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="products-grid">
      {featuredProducts.map((product) => (
        <div class="product-item" data-category={product.data.category}>
          <ProductCard product={product} />
        </div>
      ))}
    </div>

    <!-- View All Link -->
    <div class="text-center mt-16 md:mt-20">
      <a
        href="/products"
        class="group inline-flex items-center justify-center gap-3 border border-white/20 bg-white/5 hover:bg-white/10 text-white font-[400] text-lg px-10 py-4 transition-all duration-300 hover:scale-[1.03] hover:border-white/30 hover:shadow-[0_0_30px_rgba(255,255,255,0.15)]"
        style="font-family: var(--font-roobert); border-radius: 75.024px;"
      >
        <span>Ver todos los productos</span>
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script is:inline>
  (function() {
    const tabs = document.querySelectorAll('.category-tab');
    const items = document.querySelectorAll('.product-item');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.category;
        
        // Update active tab styling
        tabs.forEach(t => {
          if (t.dataset.category === category) {
            t.style.backgroundColor = '#ffffff';
            t.style.color = '#000000';
            t.style.borderColor = 'transparent';
          } else {
            t.style.backgroundColor = 'rgba(255,255,255,0.05)';
            t.style.color = 'rgba(255,255,255,0.8)';
            t.style.borderColor = 'rgba(255,255,255,0.1)';
          }
        });
        
        // Filter items
        items.forEach(item => {
          const itemCategory = item.dataset.category;
          if (category === 'all' || itemCategory === category) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  })();
</script>