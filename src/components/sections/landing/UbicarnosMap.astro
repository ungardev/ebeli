---

<section class="w-full py-12 lg:py-20 bg-[#050505]">
  <div class="container mx-auto px-4">
    <div class="mb-8">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4 text-center">
        Ubícanos en Venezuela
      </h2>
      <p class="text-whisper-gray text-center max-w-2xl mx-auto">
        Encuentra representantes y clientes Ébeli en todo el territorio nacional
      </p>
    </div>

    <div class="relative bg-deep-shadow rounded-2xl p-4 lg:p-8 mb-8">
      <div id="map-container" class="w-full aspect-[16/10] relative">
        <svg id="venezuela-map" class="w-full h-full"></svg>
        <div
          id="map-tooltip"
          class="absolute hidden bg-midnight-canvas border border-whisper-gray/30 rounded-lg px-3 py-2 text-sm text-white pointer-events-none z-10"
        >
          <span id="tooltip-text"></span>
        </div>
      </div>
    </div>

    <div id="state-filters" class="flex flex-wrap gap-2 justify-center mb-8">
      <button
        data-estado="todos"
        class="filter-pill active px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-blue-500 text-white"
      >
        Todos
      </button>
      {
        estadosConPresencia.map((estado) => (
          <button
            data-estado={estado}
            class="filter-pill px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-deep-shadow text-whisper-gray hover:bg-whisper-gray/20"
          >
            {estado}
          </button>
        ))
      }
    </div>

    <div class="overflow-x-auto rounded-xl border border-whisper-gray/20">
      <table class="w-full min-w-[640px]">
        <thead class="bg-deep-shadow">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-whisper-gray uppercase tracking-wider">
              Tipo
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-whisper-gray uppercase tracking-wider">
              Nombre
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-whisper-gray uppercase tracking-wider">
              Estado
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-whisper-gray uppercase tracking-wider">
              Ciudad
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-whisper-gray uppercase tracking-wider">
              Teléfono
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-whisper-gray uppercase tracking-wider">
              Email
            </th>
          </tr>
        </thead>
        <tbody id="distribuidor-table-body" class="divide-y divide-whisper-gray/10">
          {
            mockDistribuidores.map((dist: { id: string; nombre: string; estado: string; ciudad: string; telefono: string; email: string; tipo: string }) => (
              <tr
                data-estado={dist.estado}
                class="table-row bg-midnight-canvas hover:bg-deep-shadow/50 transition-colors"
              >
                <td class="px-4 py-3">
                  <span
                    class={`inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ${
                      dist.tipo === "distribuidor"
                        ? "bg-blue-500/20 text-blue-400"
                        : "bg-emerald-500/20 text-emerald-400"
                    }`}
                  >
                    {dist.tipo === "distribuidor" ? "Distribuidor" : "Cliente"}
                  </span>
                </td>
                <td class="px-4 py-3 text-white font-medium">{dist.nombre}</td>
                <td class="px-4 py-3 text-whisper-gray">{dist.estado}</td>
                <td class="px-4 py-3 text-whisper-gray">{dist.ciudad}</td>
                <td class="px-4 py-3 text-whisper-gray">{dist.telefono}</td>
                <td class="px-4 py-3">
                  <a
                    href={`mailto:${dist.email}`}
                    class="text-blue-400 hover:text-blue-300 transition-colors"
                  >
                    {dist.email}
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  import * as d3 from "d3";

  const geoJsonUrl =
    "https://raw.githubusercontent.com/fckfck97/Mapa-de-Venezuela-GeoJson/main/venezuela.geojson";

  const estadosConPresencia = [
    "Distrito Capital",
    "Zulia",
    "Miranda",
    "Carabobo",
    "Lara",
    "Bolívar",
    "Aragua",
    "Táchira",
  ];

  const estadosMapeados: Record<string, string> = {
    Vargas: "La Guaira",
    "Distrito Capital": "Distrito Capital",
  };

  function mapEstado(nombre: string): string {
    return estadosMapeados[nombre] || nombre;
  }

  async function initMap() {
    const container = document.getElementById("map-container");
    const svg = d3.select("#venezuela-map");
    const tooltipEl = document.getElementById("map-tooltip");
    const tooltipTextEl = document.getElementById("tooltip-text");

    if (!container || !svg.node()) return;

    const width = container.clientWidth;
    const height = container.clientHeight;

    svg.attr("viewBox", `0 0 ${width} ${height}`);

    try {
      const response = await fetch(geoJsonUrl);
      const geoData = await response.json();

      const path = d3.geoPath(
        d3.geoIdentity().fitSize([width, height], d3.geoFeatureCollection(geoData.features))
      );

      const estadosPresentesSet = new Set(estadosConPresencia);

      svg
        .append("g")
        .selectAll("path")
        .data(geoData.features)
        .enter()
        .append("path")
        .attr("d", path)
        .attr("data-estado", (d: any) => mapEstado(d.properties.NAME_1))
        .attr("fill", (d: any) => {
          const estado = mapEstado(d.properties.NAME_1);
          return estadosPresentesSet.has(estado) ? "#0066CC" : "#222222";
        })
        .attr("stroke", "#333333")
        .attr("stroke-width", 0.5)
        .style("cursor", "pointer")
        .style("transition", "fill 0.2s ease, filter 0.2s ease")
        .on("mouseenter", function (this: SVGPathElement, event: MouseEvent, d: any) {
          const estado = mapEstado(d.properties.NAME_1);
          d3.select(this).attr("filter", "brightness(1.3)");

          if (tooltipEl && tooltipTextEl) {
            tooltipTextEl.textContent = estado;
            tooltipEl.classList.remove("hidden");

            const rect = container.getBoundingClientRect();
            const tooltipRect = tooltipEl.getBoundingClientRect();
            const x = event.clientX - rect.left - tooltipRect.width / 2;
            const y = event.clientY - rect.top - tooltipRect.height - 10;

            tooltipEl.style.left = `${Math.max(0, Math.min(x, rect.width - tooltipRect.width))}px`;
            tooltipEl.style.top = `${Math.max(0, y)}px`;
          }
        })
        .on("mouseleave", function (this: SVGPathElement, _event: MouseEvent) {
          d3.select(this).attr("filter", null);
          if (tooltipEl) {
            tooltipEl.classList.add("hidden");
          }
        })
        .on("click", function (_event: MouseEvent, d: any) {
          const estado = mapEstado(d.properties.NAME_1);
          filterByState(estado);
        });

      const resizeObserver = new ResizeObserver(() => {
        const newWidth = container.clientWidth;
        const newHeight = container.clientHeight;
        svg.attr("viewBox", `0 0 ${newWidth} ${newHeight}`);
        svg.selectAll("path").attr("d", path);
      });

      resizeObserver.observe(container);
    } catch (error) {
      console.error("Error loading map:", error);
    }
  }

  function filterByState(estado: string) {
    const pills = document.querySelectorAll(".filter-pill");
    pills.forEach((pill) => {
      const pillEstado = pill.getAttribute("data-estado");
      if (pillEstado === estado) {
        pill.classList.add("bg-blue-500", "text-white");
        pill.classList.remove("bg-deep-shadow", "text-whisper-gray", "hover:bg-whisper-gray/20");
      } else if (pillEstado === "todos") {
        pill.classList.remove("bg-blue-500", "text-white");
        pill.classList.add("bg-deep-shadow", "text-whisper-gray");
      } else {
        pill.classList.remove("bg-blue-500", "text-white");
        pill.classList.add("bg-deep-shadow", "text-whisper-gray");
      }
    });

    const rows = document.querySelectorAll(".table-row");
    rows.forEach((row) => {
      const rowEstado = row.getAttribute("data-estado");
      if (estado === "todos" || rowEstado === estado) {
        (row as HTMLElement).style.display = "";
      } else {
        (row as HTMLElement).style.display = "none";
      }
    });

    const mapPaths = document.querySelectorAll("#venezuela-map path");
    mapPaths.forEach((path) => {
      const pathEstado = path.getAttribute("data-estado");
      if (pathEstado === estado) {
        path.setAttribute("stroke", "#ffffff");
        path.setAttribute("stroke-width", "2");
      } else {
        path.setAttribute("stroke", "#333333");
        path.setAttribute("stroke-width", "0.5");
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    initMap();

    document.querySelectorAll(".filter-pill").forEach((pill) => {
      pill.addEventListener("click", () => {
        const estado = pill.getAttribute("data-estado") || "todos";
        filterByState(estado);
      });
    });
  });
</script>