---
import venezuelaSvg from '../../../../public/maps/venezuelaHigh.svg?raw';
---

<section class="w-full py-12 lg:py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="mb-8">
      <h2 class="text-3xl lg:text-4xl font-normal text-black mb-4 text-center" style="font-family: var(--font-manrope);">
        Selecciona un estado para ver los distribuidores en esa zona
      </h2>
    </div>

    <div class="relative bg-gray-100 rounded-2xl p-4 lg:p-8 mb-8 overflow-visible">
      <div id="map-container" class="w-full relative pt-8 overflow-visible">
        <svg
          id="map-svg"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="-2 24 964 860"
          class="w-full h-auto"
          set:html={venezuelaSvg}
        ></svg>
        <div
          id="map-tooltip"
          class="absolute hidden bg-black border border-gray-300 rounded-lg px-3 py-2 text-sm text-white pointer-events-none z-10 shadow-lg"
          style="font-family: var(--font-manrope);"
        >
          <span id="tooltip-text"></span>
        </div>
      </div>
    </div>

    <div id="filter-indicator" class="hidden flex items-center justify-center gap-4 mb-6">
      <span class="text-gray-600" style="font-family: var(--font-manrope);">
        Mostrando resultados para: <span id="selected-state-name" class="font-semibold text-black"></span>
      </span>
      <button
        id="clear-filter-btn"
        class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-full text-sm font-medium transition-all duration-200"
        style="font-family: var(--font-manrope);"
      >
        Limpiar filtro
      </button>
    </div>

    <div class="overflow-x-auto rounded-xl border border-gray-200">
      <table class="w-full min-w-[640px]">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Tipo
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Nombre
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Estado
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Ciudad
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Teléfono
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Email
            </th>
          </tr>
        </thead>
        <tbody id="distribuidor-table-body" class="divide-y divide-gray-100">
        </tbody>
      </table>
      <div id="proximo-mensaje" class="hidden py-16 text-center">
        <div class="flex flex-col items-center gap-4">
          <svg class="w-16 h-16 text-gray-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
          <h3 class="text-2xl md:text-3xl font-[300] text-gray-700 tracking-wide" style="font-family: var(--font-manrope);">
            Muy Pronto Llegaremos
          </h3>
          <p class="text-gray-500 text-sm md:text-base" style="font-family: var(--font-manrope);">
            Estamos expandiendo nuestra presencia en Venezuela
          </p>
        </div>
      </div>
      <div id="empty-table-message" class="hidden py-12 text-center text-gray-500" style="font-family: var(--font-manrope);">
        Selecciona un estado del mapa para ver los distribuidores en esa zona
      </div>
    </div>
  </div>
</section>

<style>
  #map-svg path {
    cursor: pointer;
    transition: fill 0.2s ease, stroke 0.2s ease, stroke-width 0.2s ease;
  }
  #map-svg path:hover {
    fill: #9CA3AF !important;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out forwards;
  }
</style>

<script is:inline>
  (function() {
    var selectedEstado = null;
    var mapPaths = [];
    var distribuidores = [];

    function tieneDatosParaEstado(estado) {
      return distribuidores.some(function(d) { return d.estado === estado; });
    }

    function renderTable(estado) {
      var tbody = document.getElementById('distribuidor-table-body');
      var emptyMsg = document.getElementById('empty-table-message');
      var proximoMsg = document.getElementById('proximo-mensaje');
      var tableWrapper = document.querySelector('.overflow-x-auto');

      if (!tbody) return;

      var filtrados = distribuidores.filter(function(d) { return d.estado === estado; });

      if (filtrados.length === 0) {
        mostrarMensajeProximo();
        return;
      }

      tbody.innerHTML = '';
      proximoMsg.classList.add('hidden');
      emptyMsg.classList.add('hidden');
      tableWrapper.classList.remove('hidden');

      filtrados.forEach(function(d) {
        var tr = document.createElement('tr');
        tr.className = 'border-b border-gray-100 hover:bg-gray-50 transition-colors duration-150';
        tr.innerHTML = 
          '<td class="px-4 py-3"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ' + (d.tipo === 'Distribuidor' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800') + '">' + d.tipo + '</span></td>' +
          '<td class="px-4 py-3 text-sm text-gray-900">' + d.nombre + '</td>' +
          '<td class="px-4 py-3 text-sm text-gray-600">' + d.estado + '</td>' +
          '<td class="px-4 py-3 text-sm text-gray-600">' + d.ciudad + '</td>' +
          '<td class="px-4 py-3 text-sm"><a href="tel:' + d.telefono + '" class="text-blue-600 hover:text-blue-800 hover:underline">' + d.telefono + '</a></td>' +
          '<td class="px-4 py-3 text-sm"><a href="mailto:' + d.email + '" class="text-blue-600 hover:text-blue-800 hover:underline">' + d.email + '</a></td>';
        tbody.appendChild(tr);
      });
    }

    function mostrarMensajeProximo() {
      var proximoMsg = document.getElementById('proximo-mensaje');
      var emptyMsg = document.getElementById('empty-table-message');
      var tableWrapper = document.querySelector('.overflow-x-auto');

      if (tableWrapper) tableWrapper.classList.add('hidden');
      if (emptyMsg) emptyMsg.classList.add('hidden');
      if (proximoMsg) {
        proximoMsg.classList.remove('hidden');
        proximoMsg.classList.add('animate-fade-in');
      }
    }

    function mostrarEmptyDefault() {
      var proximoMsg = document.getElementById('proximo-mensaje');
      var emptyMsg = document.getElementById('empty-table-message');
      var tableWrapper = document.querySelector('.overflow-x-auto');
      var tbody = document.getElementById('distribuidor-table-body');

      if (tableWrapper) tableWrapper.classList.remove('hidden');
      if (proximoMsg) proximoMsg.classList.add('hidden');
      if (emptyMsg) emptyMsg.classList.remove('hidden');
      if (tbody) tbody.innerHTML = '';
    }

    function getMapPathsFromDOM() {
      var svg = document.querySelector('#map-svg');
      if (svg) {
        return svg.querySelectorAll('path');
      }
      return [];
    }

    function handleStateClick(estado) {
      if (selectedEstado === estado) {
        selectedEstado = null;
        clearFilter();
      } else {
        selectedEstado = estado;
        applyFilter(estado);
      }
    }

    function applyFilter(estado) {
      var filterIndicator = document.getElementById('filter-indicator');
      var selectedStateName = document.getElementById('selected-state-name');

      if (filterIndicator && selectedStateName) {
        filterIndicator.classList.remove('hidden');
        selectedStateName.textContent = estado;
      }

      mapPaths.forEach(function(path) {
        var pathEstado = path.getAttribute('data-name');
        if (pathEstado === estado) {
          path.setAttribute('fill', '#000000');
          path.setAttribute('stroke', '#000000');
          path.setAttribute('stroke-width', '1');
        } else {
          path.setAttribute('fill', '#dadada');
          path.setAttribute('stroke', '#ffffff');
          path.setAttribute('stroke-width', '0.5');
        }
      });

      renderTable(estado);
    }

    function clearFilter() {
      selectedEstado = null;

      var filterIndicator = document.getElementById('filter-indicator');
      if (filterIndicator) {
        filterIndicator.classList.add('hidden');
      }

      mapPaths.forEach(function(path) {
        path.setAttribute('fill', '#dadada');
        path.setAttribute('stroke', '#ffffff');
        path.setAttribute('stroke-width', '0.5');
      });

      mostrarEmptyDefault();
    }

    function initMap() {
      var mapContainer = document.getElementById('map-container');
      var tooltipEl = document.getElementById('map-tooltip');
      var tooltipTextEl = document.getElementById('tooltip-text');

      if (!mapContainer) return;

      mapPaths = Array.from(getMapPathsFromDOM());
      console.log('Found', mapPaths.length, 'paths in SVG');

      mapPaths.forEach(function(path) {
        path.addEventListener('mouseenter', function(e) {
          var estado = path.getAttribute('data-name');
          if (!estado || estado === 'Distrito Capital' || estado === 'Dependencias Federales') return;

          if (tooltipEl && tooltipTextEl) {
            tooltipTextEl.textContent = estado;
            tooltipEl.classList.remove('hidden');

            var rect = mapContainer.getBoundingClientRect();
            var tooltipRect = tooltipEl.getBoundingClientRect();
            var x = e.clientX - rect.left - tooltipRect.width / 2;
            var y = e.clientY - rect.top - tooltipRect.height - 10;

            tooltipEl.style.left = Math.max(0, Math.min(x, rect.width - tooltipRect.width)) + 'px';
            tooltipEl.style.top = Math.max(0, y) + 'px';
          }

          var isSelected = selectedEstado === estado;
          if (!isSelected) {
            path.setAttribute('stroke', '#000000');
            path.setAttribute('stroke-width', '1');
          }
        });

        path.addEventListener('mouseleave', function() {
          var estado = path.getAttribute('data-name');
          var isSelected = selectedEstado === estado;

          if (tooltipEl) {
            tooltipEl.classList.add('hidden');
          }

          if (isSelected) {
            path.setAttribute('stroke', '#000000');
            path.setAttribute('stroke-width', '1');
          } else {
            path.setAttribute('stroke', '#ffffff');
            path.setAttribute('stroke-width', '0.5');
          }
        });

        path.addEventListener('click', function() {
          var estado = path.getAttribute('data-name');
          if (!estado || estado === 'Distrito Capital' || estado === 'Dependencias Federales') return;
          handleStateClick(estado);
        });
      });

      var clearBtn = document.getElementById('clear-filter-btn');
      if (clearBtn) {
        clearBtn.addEventListener('click', clearFilter);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else {
      initMap();
    }
  })();
</script>