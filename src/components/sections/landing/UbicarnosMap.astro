---
---

<section class="w-full py-12 lg:py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="mb-8">
      <h2 class="text-3xl lg:text-4xl font-bold text-black mb-4 text-center" style="font-family: var(--font-manrope);">
        Ubícanos en Venezuela
      </h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto text-lg" style="font-family: var(--font-manrope);">
        Selecciona un estado para ver los distribuidores y clientes en esa zona
      </p>
    </div>

    <div class="relative bg-gray-100 rounded-2xl p-4 lg:p-8 mb-8">
      <div id="map-container" class="w-full aspect-[16/10] relative">
        <svg id="venezuela-map" class="w-full h-full"></svg>
        <div
          id="map-tooltip"
          class="absolute hidden bg-black border border-gray-300 rounded-lg px-3 py-2 text-sm text-white pointer-events-none z-10 shadow-lg"
        >
          <span id="tooltip-text"></span>
        </div>
      </div>
    </div>

    <div id="filter-indicator" class="hidden flex items-center justify-center gap-4 mb-6">
      <span class="text-gray-600" style="font-family: var(--font-manrope);">
        Mostrando resultados para: <span id="selected-state-name" class="font-semibold text-black"></span>
      </span>
      <button
        id="clear-filter-btn"
        class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-full text-sm font-medium transition-all duration-200"
        style="font-family: var(--font-manrope);"
      >
        Limpiar filtro
      </button>
    </div>

    <div class="overflow-x-auto rounded-xl border border-gray-200">
      <table class="w-full min-w-[640px]">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Tipo
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Nombre
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Estado
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Ciudad
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Teléfono
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
              Email
            </th>
          </tr>
        </thead>
        <tbody id="distribuidor-table-body" class="divide-y divide-gray-100">
        </tbody>
      </table>
      <div id="empty-table-message" class="py-12 text-center text-gray-500" style="font-family: var(--font-manrope);">
        Selecciona un estado del mapa para ver los distribuidores y clientes en esa zona
      </div>
    </div>
  </div>
</section>

<script>
  import * as d3 from "d3";

  const geoJsonUrl =
    "https://raw.githubusercontent.com/fckfck97/Mapa-de-Venezuela-GeoJson/main/venezuela.geojson";

  const estadosMapeados: Record<string, string> = {
    Vargas: "La Guaira",
    "Distrito Capital": "Distrito Capital",
  };

  function mapEstado(nombre: string): string {
    return estadosMapeados[nombre] || nombre;
  }

  let selectedEstado: string | null = null;
  let geoDataGlobal: any = null;

  async function initMap() {
    const container = document.getElementById("map-container");
    const svg = d3.select("#venezuela-map");
    const tooltipEl = document.getElementById("map-tooltip");
    const tooltipTextEl = document.getElementById("tooltip-text");

    if (!container || !svg.node()) return;

    const width = container.clientWidth;
    const height = container.clientHeight;

    if (width === 0 || height === 0) {
      setTimeout(initMap, 100);
      return;
    }

    svg.attr("viewBox", `0 0 ${width} ${height}`);

    try {
      const response = await fetch(geoJsonUrl);
      geoDataGlobal = await response.json();

      const projection = (d3 as any).geoMercator()
        .fitExtent([[40, 40], [width - 40, height - 40]], geoDataGlobal)
        .translate([width / 2, height / 2]);

      const pathGenerator = (d3 as any).geoPath().projection(projection);

      svg
        .append("g")
        .selectAll("path")
        .data(geoDataGlobal.features)
        .enter()
        .append("path")
        .attr("d", (d: any) => pathGenerator(d))
        .attr("data-estado", (d: any) => mapEstado(d.properties.NAME_1))
        .attr("fill", "#D1D5DB")
        .attr("stroke", "#9CA3AF")
        .attr("stroke-width", 1)
        .style("cursor", "pointer")
        .style("transition", "fill 0.2s ease, stroke 0.2s ease")
        .on("mouseenter", function (this: SVGPathElement, event: MouseEvent, d: any) {
          const estado = mapEstado(d.properties.NAME_1);
          const isSelected = selectedEstado === estado;
          if (!isSelected) {
            d3.select(this).attr("stroke", "#000000").attr("stroke-width", 2);
          }

          if (tooltipEl && tooltipTextEl) {
            tooltipTextEl.textContent = estado;
            tooltipEl.classList.remove("hidden");

            const rect = container.getBoundingClientRect();
            const tooltipRect = tooltipEl.getBoundingClientRect();
            const x = event.clientX - rect.left - tooltipRect.width / 2;
            const y = event.clientY - rect.top - tooltipRect.height - 10;

            tooltipEl.style.left = `${Math.max(0, Math.min(x, rect.width - tooltipRect.width))}px`;
            tooltipEl.style.top = `${Math.max(0, y)}px`;
          }
        })
        .on("mouseleave", function (this: SVGPathElement, _event: MouseEvent) {
          const estado = d3.select(this).attr("data-estado");
          const isSelected = selectedEstado === estado;
          d3.select(this)
            .attr("stroke", isSelected ? "#000000" : "#9CA3AF")
            .attr("stroke-width", isSelected ? 2 : 1);
          if (tooltipEl) {
            tooltipEl.classList.add("hidden");
          }
        })
        .on("click", function (_event: MouseEvent, d: any) {
          const estado = mapEstado(d.properties.NAME_1);
          handleStateClick(estado);
        });

      const resizeObserver = new ResizeObserver(() => {
        if (!geoDataGlobal) return;

        const newWidth = container.clientWidth;
        const newHeight = container.clientHeight;

        if (newWidth === 0 || newHeight === 0) return;

        svg.attr("viewBox", `0 0 ${newWidth} ${newHeight}`);

        const newProjection = (d3 as any).geoMercator()
          .fitExtent([[40, 40], [newWidth - 40, newHeight - 40]], geoDataGlobal)
          .translate([newWidth / 2, newHeight / 2]);

        const newPathGenerator = (d3 as any).geoPath().projection(newProjection);

        svg.selectAll("path").attr("d", (d: any) => newPathGenerator(d));
      });

      resizeObserver.observe(container);
    } catch (error) {
      console.error("Error loading map:", error);
    }
  }

  function handleStateClick(estado: string) {
    if (selectedEstado === estado) {
      selectedEstado = null;
      clearFilter();
    } else {
      selectedEstado = estado;
      applyFilter(estado);
    }
  }

  function applyFilter(estado: string) {
    const filterIndicator = document.getElementById("filter-indicator");
    const selectedStateName = document.getElementById("selected-state-name");

    if (filterIndicator && selectedStateName) {
      filterIndicator.classList.remove("hidden");
      selectedStateName.textContent = estado;
    }

    const mapPaths = document.querySelectorAll("#venezuela-map path");
    mapPaths.forEach((path) => {
      const pathEstado = path.getAttribute("data-estado");
      if (pathEstado === estado) {
        path.setAttribute("stroke", "#000000");
        path.setAttribute("stroke-width", "2");
        path.setAttribute("fill", "#000000");
      } else {
        path.setAttribute("stroke", "#9CA3AF");
        path.setAttribute("stroke-width", "1");
        path.setAttribute("fill", "#D1D5DB");
      }
    });
  }

  function clearFilter() {
    selectedEstado = null;

    const filterIndicator = document.getElementById("filter-indicator");
    if (filterIndicator) {
      filterIndicator.classList.add("hidden");
    }

    const mapPaths = document.querySelectorAll("#venezuela-map path");
    mapPaths.forEach((path) => {
      path.setAttribute("stroke", "#9CA3AF");
      path.setAttribute("stroke-width", "1");
      path.setAttribute("fill", "#D1D5DB");
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    initMap();
  });

  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(initMap, 100);
  }

  const clearBtn = document.getElementById("clear-filter-btn");
  if (clearBtn) {
    clearBtn.addEventListener("click", clearFilter);
  }
</script>