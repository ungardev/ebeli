---
const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
}

const ledRows = 8;
const ledCols = 9;
const totalLeds = ledRows * ledCols;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-black" id="hero">
  <!-- Background effects -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Central warm glow -->
    <div class="hero-glow-central absolute inset-0 flex items-center justify-center">
      <div class="w-[800px] h-[600px] bg-gradient-radial from-white/30 via-white/15 to-transparent rounded-full blur-3xl opacity-0"></div>
    </div>
    
    <!-- Top ray - vertical beam from heaven -->
    <div class="hero-ray-top absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-full">
      <div class="w-full h-full bg-gradient-to-b from-white/20 via-white/5 to-transparent"></div>
    </div>
    
    <!-- Side rays -->
    <div class="hero-ray-left absolute top-1/4 left-0 w-[200px] h-[400px] bg-gradient-to-r from-white/10 to-transparent blur-3xl"></div>
    <div class="hero-ray-right absolute top-1/4 right-0 w-[200px] h-[400px] bg-gradient-to-l from-white/10 to-transparent blur-3xl"></div>
    
    <!-- Diagonal accent rays -->
    <div class="hero-ray-diag-left absolute top-0 left-1/4 w-[300px] h-full bg-gradient-to-br from-white/8 to-transparent rotate-12"></div>
    <div class="hero-ray-diag-right absolute top-0 right-1/4 w-[300px] h-full bg-gradient-to-bl from-white/8 to-transparent -rotate-12"></div>
  </div>

  <!-- LED Matrix 9x8 -->
  <div class="relative z-10 flex flex-col items-center justify-center">
    <!-- LED Matrix Container -->
    <div class="relative hero-matrix opacity-0">
      <!-- LED Grid -->
      <div class="flex flex-col gap-[6px]" id="led-matrix">
        {Array.from({ length: ledRows }).map((_, rowIndex) => (
          <div class="flex gap-[6px]">
            {Array.from({ length: ledCols }).map((_, colIndex) => {
              const ledIndex = rowIndex * ledCols + colIndex;
              return (
                <div 
                  class="led-cell w-[28px] h-[28px] md:w-[36px] md:h-[36px] lg:w-[42px] lg:h-[42px] rounded-[4px] bg-neutral-900 border border-neutral-800 transition-all duration-300"
                  data-led={ledIndex}
                  data-row={rowIndex}
                  data-col={colIndex}
                />
              );
            })}
          </div>
        ))}
      </div>
      
      <!-- Matrix glow overlay -->
      <div class="absolute inset-0 bg-gradient-radial from-white/40 via-white/20 to-transparent rounded-full blur-2xl opacity-0 pointer-events-none hero-matrix-glow"></div>
    </div>

    <!-- Title -->
    <h1 class="hero-title mt-16 text-7xl md:text-8xl lg:text-9xl font-bold tracking-[0.3em] text-white opacity-0 drop-shadow-[0_0_40px_rgba(255,255,255,0.6)]">
      {title}
    </h1>
    
    {subTitle && (
      <p class="hero-subtitle mt-6 text-lg md:text-xl text-neutral-300 max-w-2xl mx-auto text-center opacity-0">
        {subTitle}
      </p>
    )}
    
    <!-- Buttons -->
    <div class="hero-buttons mt-12 flex flex-col sm:flex-row items-center justify-center gap-5 opacity-0">
      {primaryBtn && (
        <a
          href={primaryBtnURL}
          class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-white px-12 py-5 font-semibold text-black transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-white/50"
        >
          <span class="relative z-10 flex items-center gap-3">
            <span>{primaryBtn}</span>
            <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
        </a>
      )}
      
      {secondaryBtn && (
        <a
          href={secondaryBtnURL}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-3 rounded-full border-2 border-neutral-600 px-12 py-5 font-semibold text-white transition-all duration-500 hover:border-green-500/80 hover:bg-green-600/20 hover:shadow-lg hover:shadow-green-500/30"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>{secondaryBtn}</span>
        </a>
      )}
    </div>
  </div>

  <!-- Floating particles -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" id="hero-particles">
    {Array.from({ length: 20 }).map((_, i) => (
      <div 
        class="particle absolute w-1 h-1 rounded-full bg-white/60 hero-particle"
        style={`
          left: ${Math.random() * 100}%;
          animation-delay: ${Math.random() * 5}s;
          animation-duration: ${4 + Math.random() * 4}s;
        `}
      />
    ))}
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0">
    <div class="flex flex-col items-center gap-2 text-neutral-500 animate-bounce">
      <span class="text-xs uppercase tracking-widest">Scroll</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

<style>
  .bg-gradient-radial {
    background: radial-gradient(ellipse at center, var(--tw-gradient-from), var(--tw-gradient-via), var(--tw-gradient-to));
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initHeroAnimations = () => {
    const leds = document.querySelectorAll('.led-cell');
    const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });

    // 1. Show matrix container
    tl.to('.hero-matrix', { opacity: 1, duration: 0.3 });

    // 2. Turn on LEDs row by row with stagger
    leds.forEach((led, index) => {
      const row = parseInt(led.getAttribute('data-row') || '0');
      const delay = row * 0.15 + index * 0.008;
      
      tl.to(led, {
        backgroundColor: '#FFFAF0',
        boxShadow: '0 0 15px rgba(255, 250, 240, 0.8), 0 0 30px rgba(255, 250, 240, 0.4)',
        borderColor: 'rgba(255, 250, 240, 0.3)',
      }, delay);
    });

    // 3. Intensify matrix glow
    tl.to('.hero-matrix-glow', {
      opacity: 1,
      scale: 1.1,
      duration: 0.8,
      ease: 'power2.inOut',
    }, '-=0.5');

    // 4. Central glow pulse
    tl.to('.hero-glow-central', {
      opacity: 1,
      duration: 1,
    }, '-=1');

    tl.to('.hero-glow-central > div', {
      scale: 1.15,
      opacity: 0.7,
      duration: 2,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    }, '-=0.5');

    // 5. Title reveal with blur
    tl.to('.hero-title', {
      opacity: 1,
      y: 0,
      filter: 'blur(0px)',
      duration: 1,
      ease: 'power3.out',
    }, '-=0.3');

    // 6. Subtitle fade up
    tl.to('.hero-subtitle', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power2.out',
    }, '-=0.5');

    // 7. Buttons fade up
    tl.to('.hero-buttons', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power2.out',
    }, '-=0.5');

    // 8. Scroll indicator
    tl.to('.hero-scroll-indicator', {
      opacity: 1,
      duration: 0.6,
    }, '-=0.3');

    // 9. Scroll indicator bounce (restart animation)
    gsap.to('.hero-scroll-indicator .animate-bounce', {
      y: 8,
      duration: 0.8,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      delay: 1,
    });

    // Parallax effects on scroll
    gsap.to('.hero-ray-top', {
      y: '-30%',
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1.5,
      },
    });

    gsap.to('.hero-ray-diag-left', {
      x: '-20%',
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 2,
      },
    });

    gsap.to('.hero-ray-diag-right', {
      x: '20%',
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 2,
      },
    });

    gsap.to('.hero-matrix', {
      scale: 0.95,
      y: '-10%',
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1,
      },
    });

    // Subtle ray movement (continuous, not scroll-triggered)
    gsap.to('.hero-ray-top > div', {
      x: 40,
      duration: 6,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });

    gsap.to('.hero-ray-left', {
      x: -30,
      duration: 8,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });

    gsap.to('.hero-ray-right', {
      x: 30,
      duration: 7,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });
  };

  // Particle floating animation (CSS-based for performance)
  const style = document.createElement('style');
  style.textContent = `
    .hero-particle {
      animation: floatUp linear infinite;
      opacity: 0;
    }
    @keyframes floatUp {
      0% {
        transform: translateY(100vh) scale(0);
        opacity: 0;
      }
      10% {
        opacity: 0.6;
        transform: translateY(90vh) scale(1);
      }
      90% {
        opacity: 0.3;
        transform: translateY(10vh) scale(0.5);
      }
      100% {
        transform: translateY(-10vh) scale(0);
        opacity: 0;
      }
    }
  `;
  document.head.appendChild(style);

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAnimations);
  } else {
    initHeroAnimations();
  }
</script>
