---
const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
}

const ledRows = 8;
const ledCols = 9;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-black" id="hero">

  <!-- Main content - centered, higher position -->
  <div class="relative z-10 flex flex-col items-center justify-center pt-20 md:pt-24 lg:pt-28">
    
    <!-- LED Matrix 9x8 - Bigger, cleaner, no halos -->
    <div class="matrix-container opacity-0">
      <div class="led-matrix">
        {Array.from({ length: ledRows }).map((_, rowIndex) => (
          <div class="led-row">
            {Array.from({ length: ledCols }).map((_, colIndex) => {
              const delay = (rowIndex * ledCols + colIndex) * 0.06;
              return (
                <div 
                  class="led"
                  style={`animation-delay: ${delay}s`}
                />
              );
            })}
          </div>
        ))}
      </div>
    </div>

    <!-- Title -->
    <h1 class="hero-title mt-10 sm:mt-12 md:mt-14 text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-bold tracking-[0.2em] text-white opacity-0">
      {title}
    </h1>
    
    {subTitle && (
      <p class="hero-subtitle mt-5 sm:mt-6 text-base sm:text-lg md:text-xl text-neutral-300 max-w-2xl mx-auto text-center px-4 opacity-0">
        {subTitle}
      </p>
    )}
    
    <!-- Buttons -->
    <div class="hero-buttons mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 opacity-0">
      {primaryBtn && (
        <a
          href={primaryBtnURL}
          class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-white px-8 sm:px-10 py-3.5 sm:py-4 font-semibold text-black transition-all duration-300 hover:scale-[1.03] hover:shadow-[0_0_30px_rgba(255,255,255,0.3)]"
        >
          <span class="relative z-10 flex items-center gap-2.5">
            <span>{primaryBtn}</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      )}
      
      {secondaryBtn && (
        <a
          href={secondaryBtnURL}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2.5 rounded-full border-2 border-neutral-600 px-8 sm:px-10 py-3.5 sm:py-4 font-semibold text-white transition-all duration-300 hover:border-green-500/70 hover:bg-green-600/15"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>{secondaryBtn}</span>
        </a>
      )}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 opacity-0">
    <div class="flex flex-col items-center gap-1.5 text-neutral-500">
      <span class="text-[10px] sm:text-xs uppercase tracking-widest">Scroll</span>
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

<style>
  /* LED Matrix - Bigger LEDs (12px), cleaner gaps (10px) */
  .led-matrix {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    background: #000;
    border-radius: 4px;
  }

  .led-row {
    display: flex;
    gap: 10px;
  }

  .led {
    width: 12px;
    height: 12px;
    background: #FFFAF0;
    border-radius: 1px;
    opacity: 0.2;
    transform: scale(0.7);
    box-shadow: none;
  }

  /* LED turn on - cascade effect */
  @keyframes ledOn {
    0% {
      opacity: 0.2;
      transform: scale(0.7);
      box-shadow: none;
    }
    100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 
        0 0 8px rgba(255,250,240,0.9),
        0 0 16px rgba(255,250,240,0.5);
    }
  }

  /* Each LED has inline delay for cascade */
  .led {
    animation: ledOn 0.3s ease-out forwards;
  }

  /* Hero content animations - delayed to let LED cascade finish */
  .matrix-container {
    animation: fadeIn 0.3s ease-out 0.1s forwards;
  }

  .hero-title {
    animation: titleReveal 1s ease-out 5s forwards;
    text-shadow: 0 0 60px rgba(255,255,255,0.4);
  }

  .hero-subtitle {
    animation: fadeUp 0.8s ease-out 5.5s forwards;
  }

  .hero-buttons {
    animation: fadeUp 0.8s ease-out 6s forwards;
  }

  .scroll-indicator {
    animation: fadeIn 0.6s ease-out 6.5s forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes titleReveal {
    from { opacity: 0; filter: blur(15px); transform: translateY(15px); }
    to { opacity: 1; filter: blur(0); transform: translateY(0); }
  }
</style>
