---
const {
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
} = Astro.props;

interface Props {
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
}
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden animated-warm-gradient hero-section" id="hero">

  <!-- Light Particles -->
  <div class="light-particles" aria-hidden="true">
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
  </div>

  <div class="relative z-10 flex flex-col items-center justify-center pt-0 md:pt-6 lg:pt-8">
    
    <img 
      src="/ebeli-logo.png" 
      alt="Ébeli - Iluminación LED Premium"
      class="w-[95vw] md:w-[50vw] lg:w-[650px] mb-4 md:mb-8 mt-[-14vh] opacity-0 logo-reveal hero-logo"
      id="hero-logo"
    />
    
    {subTitle && (
      <p class="hero-subtitle mt-4 sm:mt-6 text-lg sm:text-xl md:text-2xl text-white max-w-2xl mx-auto text-center px-4 opacity-0" style="font-family: var(--font-roobert);">
        {subTitle}
      </p>
    )}
    
    <div class="hero-buttons mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 opacity-0">
      {primaryBtn && (
        <a
          href={primaryBtnURL}
          class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-white px-8 sm:px-10 py-3.5 sm:py-4 font-[600] text-black transition-all duration-200 hover:scale-[1.03] hover:shadow-[0_0_30px_rgba(255,255,255,0.3)]"
          style="font-family: var(--font-roobert);"
        >
          <span class="relative z-10 flex items-center gap-2.5">
            <span>{primaryBtn}</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      )}
      
      {secondaryBtn && (
        <a
          href={secondaryBtnURL}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2.5 rounded-full border border-white/30 px-8 sm:px-10 py-3.5 sm:py-4 font-[400] text-white transition-all duration-200 hover:border-white/50 hover:bg-white/5"
          style="font-family: var(--font-roobert);"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>{secondaryBtn}</span>
        </a>
      )}
    </div>
  </div>

  <div class="scroll-indicator absolute bottom-10 sm:bottom-12 left-1/2 -translate-x-1/2 z-10 opacity-0 md:hidden">
    <div class="flex flex-col items-center gap-2 text-[#6d6d6d]">
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.3em]">Scroll</span>
      <svg class="w-5 h-5 scroll-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-section {
    will-change: opacity;
    transition: opacity 0.5s ease-out;
  }

  .hero-section.faded {
    opacity: 0.4;
  }

  .logo-reveal {
    animation: logoReveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    will-change: opacity, transform, filter;
  }

  .hero-subtitle {
    animation: fadeUpBlur 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
    will-change: opacity, transform, filter;
  }

  .hero-buttons {
    animation: fadeUpBlur 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;
    will-change: opacity, transform;
  }

  .scroll-indicator {
    animation: fadeIn 0.4s ease-out 1.3s forwards;
  }

  .scroll-pulse {
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes logoReveal {
    0% {
      opacity: 0;
      transform: scale(0.85) translateY(20px);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
  }

  @keyframes fadeUpBlur {
    0% {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes scrollPulse {
    0%, 100% {
      opacity: 0.5;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(5px);
    }
  }

  /* Parallax for hero logo */
  @media (min-width: 768px) {
    .hero-logo {
      transform: translateY(0);
      transition: transform 0.1s linear;
    }
  }
</style>

<script>
  // Hero fade out on scroll
  const heroSection = document.querySelector('.hero-section');
  const heroLogo = document.getElementById('hero-logo');
  
  if (heroSection && heroLogo) {
    let lastScroll = 0;
    
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      const heroHeight = window.innerHeight;
      
      if (currentScroll > 100) {
        const fadeProgress = Math.min((currentScroll - 100) / (heroHeight * 0.5), 1);
        heroSection.classList.toggle('faded', fadeProgress > 0.3);
        
        // Parallax effect for logo
        if (heroLogo instanceof HTMLElement) {
          const parallaxOffset = currentScroll * 0.15;
          heroLogo.style.transform = `translateY(${parallaxOffset}px) ${fadeProgress > 0.5 ? 'scale(' + (1 - fadeProgress * 0.2) + ')' : ''}`;
        }
      } else {
        heroSection.classList.remove('faded');
        if (heroLogo instanceof HTMLElement) {
          heroLogo.style.transform = 'translateY(0)';
        }
      }
      
      lastScroll = currentScroll;
    }, { passive: true });
  }
</script>