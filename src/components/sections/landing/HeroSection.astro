---
const {
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
} = Astro.props;

interface Props {
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
}
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden animated-warm-gradient hero-section" id="hero">

  <!-- Light Particles -->
  <div class="light-particles" aria-hidden="true">
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
    <div class="light-particle"></div>
  </div>

  <div class="relative z-10 flex flex-col items-center justify-center pt-0 md:pt-6 lg:pt-8">
    
    <img 
      src="/ebeli-logo.png" 
      alt="Ébeli - Iluminación LED Premium"
      class="w-[95vw] md:w-[50vw] lg:w-[650px] mb-6 md:mb-10 mt-[-14vh] opacity-0 logo-reveal hero-logo"
      id="hero-logo"
    />
    
    {subTitle && (
      <p class="hero-subtitle mt-6 sm:mt-8 text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white max-w-4xl mx-auto text-center px-6 opacity-0" style="font-family: var(--font-roobert);">
        {subTitle}
      </p>
    )}
    
    <div class="hero-buttons mt-10 sm:mt-14 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 opacity-0">
      {primaryBtn && (
        <a
          href={primaryBtnURL}
          class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-white px-12 sm:px-14 py-5 sm:py-6 font-[600] text-black transition-all duration-300 hover:scale-[1.05] hover:shadow-[0_0_40px_rgba(255,255,255,0.4)]"
          style="font-family: var(--font-roobert);"
        >
          <span class="relative z-10 flex items-center gap-3">
            <span class="text-lg sm:text-xl">{primaryBtn}</span>
            <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      )}
    </div>
  </div>

  <div class="scroll-indicator absolute bottom-10 sm:bottom-12 left-1/2 -translate-x-1/2 z-10 opacity-0 md:hidden">
    <div class="flex flex-col items-center gap-2 text-[#6d6d6d]">
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.3em]">Scroll</span>
      <svg class="w-5 h-5 scroll-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-section {
    will-change: opacity;
    transition: opacity 0.5s ease-out;
  }

  .hero-section.faded {
    opacity: 0.4;
  }

  .logo-reveal {
    animation: logoReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    will-change: opacity, transform, filter;
  }

  .hero-subtitle {
    animation: heroSubtitleReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;
    will-change: opacity, transform, filter;
    text-shadow: 0 2px 30px rgba(255, 250, 240, 0.15);
  }

  .hero-buttons {
    animation: heroButtonsReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.1s forwards;
    will-change: opacity, transform;
  }

  .scroll-indicator {
    animation: fadeIn 0.4s ease-out 1.3s forwards;
  }

  .scroll-pulse {
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes logoReveal {
    0% {
      opacity: 0;
      transform: scale(0.8) translateY(30px);
      filter: blur(15px);
    }
    50% {
      opacity: 0.7;
      filter: blur(5px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
  }

  @keyframes heroSubtitleReveal {
    0% {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
      filter: blur(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes heroButtonsReveal {
    0% {
      opacity: 0;
      transform: translateY(25px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes scrollPulse {
    0%, 100% {
      opacity: 0.5;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(5px);
    }
  }

  @media (min-width: 768px) {
    .hero-logo {
      transform: translateY(0);
      transition: transform 0.1s linear;
    }
  }
</style>

<script>
  // Hero fade out on scroll
  const heroSection = document.querySelector('.hero-section');
  const heroLogo = document.getElementById('hero-logo');
  
  if (heroSection && heroLogo) {
    let lastScroll = 0;
    
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      const heroHeight = window.innerHeight;
      
      if (currentScroll > 100) {
        const fadeProgress = Math.min((currentScroll - 100) / (heroHeight * 0.5), 1);
        heroSection.classList.toggle('faded', fadeProgress > 0.3);
        
        // Parallax effect for logo
        if (heroLogo instanceof HTMLElement) {
          const parallaxOffset = currentScroll * 0.15;
          heroLogo.style.transform = `translateY(${parallaxOffset}px) ${fadeProgress > 0.5 ? 'scale(' + (1 - fadeProgress * 0.2) + ')' : ''}`;
        }
      } else {
        heroSection.classList.remove('faded');
        if (heroLogo instanceof HTMLElement) {
          heroLogo.style.transform = 'translateY(0)';
        }
      }
      
      lastScroll = currentScroll;
    }, { passive: true });
  }
</script>