---
import { Image } from 'astro:assets';

const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  src,
  alt,
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  src?: any;
  alt?: string;
}
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Animated radial gradient light effect -->
  <div class="absolute inset-0 bg-black">
    <div class="absolute inset-0 animate-pulse-slow">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-gradient-radial from-white/5 via-white/2 to-transparent rounded-full blur-3xl"></div>
    </div>
    <!-- Secondary glow from bottom -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-gradient-to-t from-neutral-900/50 to-transparent"></div>
    <!-- Subtle light rays -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[2px] h-full bg-gradient-to-b from-white/10 via-transparent to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-6xl font-bold tracking-tight text-white sm:text-7xl lg:text-8xl fade-in animate-title">
      {title}
    </h1>
    
    {subTitle && (
      <p class="mt-8 text-lg md:text-xl text-neutral-400 max-w-2xl mx-auto fade-in animate-subtitle">
        {subTitle}
      </p>
    )}
    
    <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-5 fade-in animate-buttons">
      {primaryBtn && (
        <a
          href={primaryBtnURL}
          class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-white px-10 py-5 font-semibold text-black transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-white/30"
        >
          <span class="relative z-10 flex items-center gap-3">
            <span>{primaryBtn}</span>
            <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
        </a>
      )}
      
      {secondaryBtn && (
        <a
          href={secondaryBtnURL}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-3 rounded-full border-2 border-neutral-600/50 px-10 py-5 font-semibold text-white transition-all duration-500 hover:border-green-500/80 hover:bg-green-600/10 hover:shadow-lg hover:shadow-green-500/20"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>{secondaryBtn}</span>
        </a>
      )}
    </div>
  </div>

  <!-- Image overlay (when available) -->
  {src && alt && (
    <div class="absolute inset-0 z-0">
      <Image
        src={src}
        alt={alt}
        class="h-full w-full object-cover opacity-20"
        draggable="false"
        loading="eager"
        format="avif"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-black/40"></div>
    </div>
  )}

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <div class="flex flex-col items-center gap-2 text-neutral-500">
      <span class="text-xs uppercase tracking-widest">Scroll</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

<style>
  /* Radial gradient animation - 8 seconds for elegant slow pulse */
  .animate-pulse-slow {
    animation: pulseGlow 8s ease-in-out infinite;
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  /* Title fade in with clip-path reveal */
  .animate-title {
    animation: titleReveal 1.2s ease-out forwards;
    opacity: 0;
  }

  @keyframes titleReveal {
    from {
      opacity: 0;
      transform: translateY(30px);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* Subtitle staggered animation */
  .animate-subtitle {
    animation: fadeInUp 1s ease-out 0.3s forwards;
    opacity: 0;
  }

  /* Buttons staggered animation */
  .animate-buttons {
    animation: fadeInUp 1s ease-out 0.6s forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Radial gradient background utility */
  .bg-gradient-radial {
    background: radial-gradient(ellipse at center, var(--tw-gradient-from), var(--tw-gradient-via), var(--tw-gradient-to));
  }
</style>