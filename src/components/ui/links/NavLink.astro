---
const { url, name, customClass = '' } = Astro.props;

interface Props {
  url: string;
  name: string;
  customClass?: string;
}
---

<a
  id={url === '/' ? 'home' : url.replace('/', '')}
  href={url}
  data-astro-prefetch
  class={`rounded-lg text-base font-medium text-white ring-zinc-500 outline-hidden hover:text-neutral-200 focus-visible:ring-3 md:py-3 md:text-sm 2xl:text-base dark:text-white dark:ring-zinc-200 dark:hover:text-neutral-300 dark:focus:outline-hidden ${customClass}`}
>
  {name}
</a>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let url = window.location.pathname;
    let navId;

    if (url === '/') {
      navId = 'home';
    } else {
      navId = url.replace('/', '');
    }

    let nav = document.getElementById(navId);

    if (nav) {
      nav.classList.remove(
        'text-neutral-600',
        'dark:text-neutral-400',
        'hover:text-neutral-500',
        'dark:hover:text-neutral-500'
      );
      nav.classList.add('text-white');
      nav.setAttribute('aria-current', 'page');
    }
  });
</script>