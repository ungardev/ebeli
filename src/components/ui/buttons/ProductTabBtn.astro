---
const { id, dataTab, title, first } = Astro.props;

interface Props {
  id: string;
  dataTab: string;
  title: string;
  first?: boolean;
}

const BUTTON_CLASS =
  'flex w-full justify-center rounded-xl border border-transparent p-3 outline-hidden ring-zinc-500 transition-all duration-300 hover:bg-white/10 focus-visible:ring-3 md:p-5 tab-btn';

const HEADING_CLASS = 'block text-center font-bold text-base md:text-lg';
const INACTIVE_HEADING_CLASS = 'text-neutral-400';
const TAB_ID = id + '-tab';
const TEXT_ID = id + '-text';
---

<button
  type="button"
  class={`${BUTTON_CLASS} ${first ? 'active border-white/30 bg-white/10' : ''}`}
  id={TAB_ID}
  data-target={dataTab}
  data-text-id={TEXT_ID}
  role="tab"
  aria-selected={first ? 'true' : 'false'}
>
  <span
    id={TEXT_ID}
    class={`${HEADING_CLASS} ${first ? 'text-white' : INACTIVE_HEADING_CLASS}`}
    style={first ? 'color: white !important' : ''}
  >
    {title}
  </span>
</button>

<style>
.tab-btn[aria-selected="true"] {
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.1);
}
.tab-btn[aria-selected="true"] span {
  color: white !important;
}
.tab-btn:hover:not([aria-selected="true"]) {
  background: rgba(255, 255, 255, 0.05);
}
</style>

<script>
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const nav = btn.closest('nav');
    if (!nav) return;
    
    nav.querySelectorAll('.tab-btn').forEach(b => {
      b.setAttribute('aria-selected', 'false');
      b.classList.remove('border-white/30', 'bg-white/10');
      b.classList.add('border-transparent');
      const span = b.querySelector('span');
      if (span) {
        span.style.color = '';
        span.classList.remove('text-white');
        span.classList.add('text-neutral-400');
      }
    });
    
    btn.setAttribute('aria-selected', 'true');
    btn.classList.add('border-white/30', 'bg-white/10');
    btn.classList.remove('border-transparent');
    const span = btn.querySelector('span');
    if (span) {
      span.style.color = 'white';
      span.classList.remove('text-neutral-400');
      span.classList.add('text-white');
    }

    const tabId = btn.getAttribute('data-target');
    if (tabId) {
      document.querySelectorAll('[role="tabpanel"]').forEach(panel => {
        panel.classList.add('hidden');
      });
      const contentElement = document.querySelector(tabId);
      if (contentElement) {
        contentElement.classList.remove('hidden');
      }
    }
  });
});
</script>
