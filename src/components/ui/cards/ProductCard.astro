---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
  class?: string;
}

const { product, class: className = '' } = Astro.props;

const categoryLabels: Record<string, string> = {
  bombillos: 'Bombillos',
  lamparas: 'Lámparas',
  tubos: 'Tubos',
  reflectores: 'Reflectores',
  cintas: 'Cintas LED',
  paneles: 'Paneles',
};

const watts = product.data.watts as number[];
---

<a
  href={`/products/${product.data.id || product.id}`}
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 transition-all duration-300 hover:border-white/10 hover:shadow-[0_0_15px_rgba(255,255,255,0.12)]',
    className,
  ]}
  data-category={product.data.category}
  data-astro-prefetch
>
  <!-- Image Container -->
  <div class="relative aspect-[4/5] w-full bg-[#0a0a0a] rounded-xl flex items-center justify-center p-0 overflow-hidden">
    <!-- Wrapper Anidado - guillotina interna para el zoom -->
    <div class="absolute inset-0 w-full h-full overflow-hidden flex items-center justify-center">
      <Image
        src={product.data.mainImage}
        alt={product.data.title}
        format="webp"
        quality="max"
        class:list={[
          'h-full w-full object-contain transition-transform duration-500',
          product.data.category === 'bombillos'
            ? 'object-center scale-[2.10] group-hover:scale-[2.20]'
            : product.data.category === 'reflectores'
            ? 'object-center scale-[1.80] group-hover:scale-[1.90]'
            : product.data.category === 'cintas'
            ? 'object-bottom scale-[1.65] group-hover:scale-[1.75]'
            : 'object-center scale-95 group-hover:scale-100'
        ]}
        loading="lazy"
      />
    </div>
    <!-- Category Badge -->
    <div class="absolute left-4 top-4">
      <span class="inline-block rounded-full bg-black/60 backdrop-blur-sm px-3 py-1 text-xs font-[400] uppercase tracking-wider text-white/80 border border-white/10">
        {categoryLabels[product.data.category] || product.data.category}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="flex flex-col gap-3 p-5">
    <!-- Title -->
    <h3 class="font-[300] text-xl md:text-2xl text-white group-hover:text-white/90 transition-colors duration-200 line-clamp-2" style="font-family: var(--font-roobert);">
      {product.data.title}
    </h3>

    <!-- Watts Badges -->
    <div class="flex flex-wrap gap-2">
      {watts.map((w) => (
        <span class="inline-flex items-center justify-center rounded-full bg-white/5 border border-white/10 px-3 py-1 text-sm font-[400] text-white/90">
          {w}W
        </span>
      ))}
    </div>

    <!-- Specs preview if available -->
    {product.data.specs?.flux && (
      <p class="text-base text-white/70">
        {product.data.specs.flux}
      </p>
    )}

    <!-- View Product indicator -->
    <div class="mt-2 flex items-center gap-2 text-base text-white/60 group-hover:text-white/80 transition-colors duration-200">
      <span>Ver producto</span>
      <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>