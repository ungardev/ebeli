---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
  class?: string;
}

const { product, class: className = '' } = Astro.props;

const categoryLabels: Record<string, string> = {
  bombillos: 'Bombillos',
  lamparas: 'Lámparas',
  tubos: 'Tubos',
  reflectores: 'Reflectores',
  cintas: 'Cintas LED',
  paneles: 'Paneles',
};

const watts = product.data.watts as number[];

const subCategory = product.data.subCategory as string | undefined;

const getProductScale = (category: string, sub?: string, productId?: string) => {
  if (productId === 'bombillo-led-clasico') {
    return 'object-center scale-[1.50] translate-x-[3%] group-hover:scale-[1.60] group-hover:translate-x-[3%]';
  }
  if (productId === 'bombillo-led-domo') {
    return 'object-center scale-[2.20] group-hover:scale-[2.30]';
  }
  if (sub === 'dicroicos' || sub === 'velas' || sub === 'lipstick') {
    return 'object-center scale-[1.50] group-hover:scale-[1.60]';
  }
  if (category === 'bombillos') {
    return 'object-center scale-[1.50] group-hover:scale-[1.60]';
  }
  if (category === 'cintas') {
    return 'object-top scale-[1.20] group-hover:scale-[1.30]';
  }
  if (category === 'reflectores') {
    return 'object-center scale-[1.80] group-hover:scale-[1.90]';
  }
  return 'object-center scale-95 group-hover:scale-100';
};

const productScale = getProductScale(product.data.category, subCategory, product.id);

const images = (product.data as any).images as string[] | undefined;
const hasMultipleImages = images && images.length > 1;
---

<a
  href={`/products/${product.data.id || product.id}`}
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 transition-all duration-300 hover:border-white/10 hover:shadow-[0_0_15px_rgba(255,255,255,0.12)]',
    className,
  ]}
  data-category={product.data.category}
  data-astro-prefetch
>
  <!-- Image Container -->
  <div class="relative aspect-[4/5] w-full bg-[#0a0a0a] rounded-xl flex items-center justify-center p-0 overflow-hidden">
    <!-- Wrapper Anidado - guillotina interna para el zoom -->
    <div class="absolute inset-0 w-full h-full overflow-hidden flex items-center justify-center">
      <Image
        src={product.data.mainImage}
        alt={product.data.title}
        format="webp"
        quality={85}
        class:list={[
          'h-full w-full object-contain transition-transform duration-500',
          productScale
        ]}
        loading="lazy"
      />
    </div>
    <!-- Category Badge -->
    <div class="absolute left-4 top-4">
      <span class="inline-block rounded-full bg-black/60 backdrop-blur-sm px-3 py-1 text-xs font-[400] uppercase tracking-wider text-white/80 border border-white/10">
        {categoryLabels[product.data.category] || product.data.category}
      </span>
    </div>
    <!-- Multi-image indicator -->
    {hasMultipleImages && (
      <div class="absolute right-4 top-4 flex items-center gap-1 bg-black/60 backdrop-blur-sm px-2 py-1 rounded-full border border-white/10">
        <svg class="w-3 h-3 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M18 6l-4 4" />
        </svg>
        <span class="text-xs text-white/80">{images.length + 1}</span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-col gap-3 p-5">
    <!-- Title -->
    <h3 class="font-[300] text-xl md:text-2xl text-white group-hover:text-white/90 transition-colors duration-200 line-clamp-2" style="font-family: var(--font-roobert);">
      {product.data.title}
    </h3>

    <!-- Watts Badges -->
    <div class="flex flex-wrap gap-2">
      {watts.map((w) => (
        <span class="inline-flex items-center justify-center rounded-full bg-white/5 border border-white/10 px-3 py-1 text-sm font-[400] text-white/90">
          {w}W
        </span>
      ))}
    </div>

    <!-- Specs preview if available -->
    {product.data.specs?.flux && (
      <p class="text-base text-white/70">
        {product.data.specs.flux}
      </p>
    )}

    <!-- View Product indicator -->
    <div class="mt-2 flex items-center gap-2 text-base text-white/60 group-hover:text-white/80 transition-colors duration-200">
      <span>Ver producto</span>
      <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>