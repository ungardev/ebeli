<svg {...Astro.props} viewBox="0 0 400 80" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="logoGlow" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="white" stop-opacity="1"/>
      <stop offset="100%" stop-color="white" stop-opacity="0.6"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- ÉBELI Text - Premium Geometric Style -->
  <g filter="url(#glow)">
    <text 
      x="50%" 
      y="50%" 
      dominant-baseline="middle" 
      text-anchor="middle"
      font-family="'Space Grotesk', 'Inter', system-ui, sans-serif"
      font-weight="800"
      font-size="52"
      letter-spacing="0.35em"
      fill="white"
      class="text-white"
    >
      ÉBELI
    </text>
  </g>
  
  <!-- Subtle underline accent -->
  <rect 
    x="85" 
    y="62" 
    width="230" 
    height="2" 
    rx="1" 
    fill="white" 
    fill-opacity="0.3"
  />
  
  <!-- LED dot accent - top right -->
  <rect x="340" y="12" width="8" height="8" rx="2" fill="white" fill-opacity="0.8"/>
  <rect x="352" y="12" width="8" height="8" rx="2" fill="white" fill-opacity="0.5"/>
  <rect x="340" y="24" width="8" height="8" rx="2" fill="white" fill-opacity="0.3"/>
  <rect x="352" y="24" width="8" height="8" rx="2" fill="white" fill-opacity="0.15"/>
</svg>
