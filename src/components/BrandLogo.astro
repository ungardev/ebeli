<svg {...Astro.props} viewBox="0 0 300 55" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- ÉBELI text - Brand: Roobert font, larger, bold presence -->
  <text 
    x="15" 
    y="42" 
    font-family="'Roobert', system-ui, sans-serif"
    font-weight="600" 
    font-size="38" 
    letter-spacing="0.24em" 
    fill="white"
  >
    ÉBELI
  </text>
  
  <!-- LED dots with warm glow effect -->
  <defs>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- 4 LED dots - warm white with glow -->
  <rect x="242" y="10" width="8" height="8" rx="2" fill="#FFFAF0" opacity="0.95" filter="url(#glow)"/>
  <rect x="253" y="10" width="8" height="8" rx="2" fill="#FFFAF0" opacity="0.7" filter="url(#glow)"/>
  <rect x="242" y="21" width="8" height="8" rx="2" fill="#FFFAF0" opacity="0.5" filter="url(#glow)"/>
  <rect x="253" y="21" width="8" height="8" rx="2" fill="#FFFAF0" opacity="0.3" filter="url(#glow)"/>
  
  <!-- Subtle underline accent -->
  <rect x="20" y="50" width="180" height="1.5" rx="0.75" fill="white" opacity="0.12"/>
</svg>

<style>
  /* Pulse animation for LED dots - very subtle */
  svg [fill="#FFFAF0"] {
    animation: ledPulse 3s ease-in-out infinite;
  }
  
  svg [fill="#FFFAF0"]:nth-child(1) { animation-delay: 0s; }
  svg [fill="#FFFAF0"]:nth-child(2) { animation-delay: 0.2s; }
  svg [fill="#FFFAF0"]:nth-child(3) { animation-delay: 0.4s; }
  svg [fill="#FFFAF0"]:nth-child(4) { animation-delay: 0.6s; }
  
  @keyframes ledPulse {
    0%, 100% { opacity: 0.95; }
    50% { opacity: 0.6; }
  }
</style>